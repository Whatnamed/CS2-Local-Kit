# Patch files must not undergo EOL translation: git apply against a fresh upstream
# checkout fails if CRLF/LF get rewritten in the working tree.
experiments/**/*.patch -text
data/match-setup/*.json text eol=lf
docs/archive/2026-10-22-match-setup/*.json text eol=lf
docs/archive/2026-10-22-match-setup/*.log text eol=lf
