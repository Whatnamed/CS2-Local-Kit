<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WPF UI owns primitive templates, popups, scrolling and focus states. -->
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontUi}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/></Style>
    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="MonoText" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
    <Style x:Key="GroupName" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="Margin" Value="10,14,10,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="FontFamily" Value="{StaticResource FontUi}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/><Setter Property="Background" Value="{StaticResource BrushBgRaised}"/><Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource BrushAccent}"/><Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}"/><Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{StaticResource BrushDanger}"/></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="FontFamily" Value="{StaticResource FontUi}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="{StaticResource BrushBgRail}"/><Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/></Style>
    <Style x:Key="CompactInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="TextAlignment" Value="Center"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="30"/></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinHeight" Value="34"/><Setter Property="MaxDropDownHeight" Value="320"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/></Style>
    <Style x:Key="ListRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
    <Style x:Key="WearSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}"><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/><Setter Property="IsMoveToPointEnabled" Value="True"/></Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource BrushBgHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource BrushBgSelected}"/><Setter Property="Foreground" Value="{StaticResource BrushAccent}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BrushAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RailItem" TargetType="RadioButton" BasedOn="{StaticResource Segment}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="8,2"/><Setter Property="MinHeight" Value="44"/></Style>
    <Style x:Key="CardToggle" TargetType="ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{StaticResource BrushBgRaised}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="4"><ContentPresenter/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BrushAccent}"/><Setter TargetName="Surface" Property="Background" Value="{StaticResource BrushBgSelected}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource BrushBgSurface}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
    <Style x:Key="Divider" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{StaticResource BrushBorderSubtle}"/><Setter Property="Margin" Value="0,14"/></Style>
    <Style x:Key="VerticalDivider" TargetType="Border"><Setter Property="Width" Value="1"/><Setter Property="Background" Value="{StaticResource BrushBorderSubtle}"/><Setter Property="Margin" Value="12,0"/></Style>
</ResourceDictionary>
