<Window x:Class="CS2LocalKit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CS2LocalKit.App.Views"
        Title="CS2 Local Kit" Width="1280" Height="840"
        MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgWindow}">
    <Grid>

        <!-- preparation state: reading the pinned snapshot is disk + JSON work -->
        <Grid x:Name="LoadingHost">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource BrushAccent}"
                        HorizontalAlignment="Center">
                    <UniformGrid Rows="2" Columns="2" Margin="10">
                        <Border Background="#33FFFFFF" CornerRadius="3" Margin="2"/>
                        <Border Background="#66FFFFFF" CornerRadius="3" Margin="2"/>
                        <Border Background="#66FFFFFF" CornerRadius="3" Margin="2"/>
                        <Border Background="#33FFFFFF" CornerRadius="3" Margin="2"/>
                    </UniformGrid>
                </Border>
                <TextBlock Text="CS2 Local Kit" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <TextBlock x:Name="LoadingText" Text="正在准备物品清单…" Style="{StaticResource HintText}"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="180" Height="3"
                             Margin="0,18,0,0" Background="{StaticResource BrushBgPressed}"
                             Foreground="{StaticResource BrushAccent}" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ShellHost" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- navigation rail -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgRail}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="64" BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource BrushAccent}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid Rows="2" Columns="2" Margin="6">
                                <Border Background="#40FFFFFF" CornerRadius="2" Margin="1"/>
                                <Border Background="#80FFFFFF" CornerRadius="2" Margin="1"/>
                                <Border Background="#80FFFFFF" CornerRadius="2" Margin="1"/>
                                <Border Background="#40FFFFFF" CornerRadius="2" Margin="1"/>
                            </UniformGrid>
                        </Border>
                    </Border>
                    <StackPanel>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav"
                                     IsChecked="{Binding Navigation.IsCosmeticsSelected, Mode=OneWay}"
                                     Command="{Binding Navigation.NavigateCosmeticsCommand}">
                            <StackPanel>
                                <Grid Width="22" Height="22" Margin="0,0,0,6">
                                    <UniformGrid Rows="2" Columns="2">
                                        <Border Width="9" Height="9" CornerRadius="3" Margin="1.5"
                                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <Border Width="9" Height="9" CornerRadius="3" Margin="1.5"
                                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <Border Width="9" Height="9" CornerRadius="3" Margin="1.5"
                                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <Border Width="9" Height="9" CornerRadius="3" Margin="1.5"
                                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    </UniformGrid>
                                </Grid>
                                <TextBlock Text="饰品" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav"
                                     IsChecked="{Binding Navigation.IsPresetsSelected, Mode=OneWay}"
                                     Command="{Binding Navigation.NavigatePresetsCommand}">
                            <StackPanel>
                                <StackPanel Width="22" Margin="0,0,0,6">
                                    <Border Height="3" CornerRadius="2" Width="20" Margin="0,2"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Border Height="3" CornerRadius="2" Width="14" Margin="0,2" HorizontalAlignment="Left"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Border Height="3" CornerRadius="2" Width="18" Margin="0,2"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                                <TextBlock Text="预设" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav"
                                     IsChecked="{Binding Navigation.IsRuntimeStatusSelected, Mode=OneWay}"
                                     Command="{Binding Navigation.NavigateRuntimeStatusCommand}">
                            <StackPanel>
                                <Grid Width="22" Height="22" Margin="0,0,0,6">
                                    <Ellipse Width="20" Height="20" StrokeThickness="2"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                                <TextBlock Text="状态" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" LastChildFill="True">

                <!-- window bar: four separate preset facts, never collapsed into one "current" -->
                <Grid DockPanel.Dock="Top" Height="76" Margin="28,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Navigation.PageTitle}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding Navigation.PageSubtitle}" Style="{StaticResource HintText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="正在编辑" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Header.EditingName}" FontWeight="SemiBold" MaxWidth="170"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="未保存" FontSize="11.5" Margin="7,1,0,0"
                                           Foreground="{StaticResource BrushWarning}"
                                           Visibility="{Binding Header.IsDirty, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource VerticalDivider}"/>

                        <StackPanel Margin="0,0,18,0" ToolTip="InventorySimulator 启动时读取的指针；它不代表文件已经写入游戏。">
                            <TextBlock Text="激活预设" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}"/>
                            <TextBlock Text="{Binding Header.ActiveName}" FontWeight="SemiBold" Margin="0,2,0,0"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Style="{StaticResource VerticalDivider}"/>

                        <StackPanel Margin="0,0,18,0" ToolTip="{Binding Header.InstalledConfigDetail}">
                            <TextBlock Text="游戏内配置" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}"/>
                            <TextBlock Text="{Binding Header.InstalledConfigName}" FontWeight="SemiBold"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource VerticalDivider}"/>

                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Header.HealthSummary}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding Header.HealthLevel, Converter={StaticResource HealthBrush}}"/>
                                <TextBlock Text="{Binding Header.Cs2StatusText}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Header.HealthSummary}" Style="{StaticResource HintText}"
                                       FontSize="10.5" MaxWidth="240" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" Margin="16,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- action bar: dirty state and the two operations that change the world -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                        Padding="28,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Header.DraftStatusText}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                            <Border Width="1" Height="14" Background="{StaticResource BrushBorderSubtle}"
                                    Margin="14,0"
                                    Visibility="{Binding Cosmetics.IsStatusVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Cosmetics.StatusMessage}"
                                       Visibility="{Binding Cosmetics.IsStatusVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cosmetics.IsStatusSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="放弃更改" Style="{StaticResource GhostButton}"
                                    Command="{Binding Header.DiscardCommand}" Margin="0,0,8,0"/>
                            <Button Content="保存预设" Command="{Binding Header.SaveCommand}"
                                    MinWidth="96" Margin="0,0,10,0"/>
                            <Button Content="应用到 CS2" Style="{StaticResource PrimaryButton}" MinWidth="120"
                                    Command="{Binding Header.ApplyCommand}">
                                <Button.ToolTip>
                                    <TextBlock Text="CS2 正在运行时无法应用，请先关闭游戏。" MaxWidth="220"/>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0">
                    <views:CosmeticsView DataContext="{Binding Cosmetics}"
                        Visibility="{Binding DataContext.Navigation.IsCosmeticsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:PresetsView DataContext="{Binding Presets}"
                        Visibility="{Binding DataContext.Navigation.IsPresetsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:RuntimeStatusView DataContext="{Binding RuntimeStatus}"
                        Visibility="{Binding DataContext.Navigation.IsRuntimeStatusSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
