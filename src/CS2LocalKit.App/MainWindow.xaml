<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CS2LocalKit.App.Views" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="CS2LocalKit.App.MainWindow" Title="CS2 Local Kit" Width="1280" Height="840" MinWidth="1024" MinHeight="660" WindowStartupLocation="CenterScreen" Background="{StaticResource BrushBgWindow}" UseLayoutRounding="True">
    <Grid Background="{StaticResource BrushBgWindow}">
        <Grid x:Name="LoadingHost">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Games24" FontSize="40" Foreground="{StaticResource BrushAccent}"/>
                <TextBlock Text="CS2 Local Kit" Style="{StaticResource PageTitle}" Margin="0,18,0,8"/>
                <TextBlock x:Name="LoadingText" Text="正在读取本地清单…" Style="{StaticResource HintText}"/>
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="3" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="ShellHost" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource BrushBgRail}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,26,16,24">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Games24" Foreground="{StaticResource BrushAccent}" FontSize="27" Margin="0,0,10,0"/><TextBlock Text="LOCAL KIT" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/></StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,16,18,22">
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="离线 · 本地游玩" FontSize="12"/>
                        <TextBlock Text="游戏内效果待实际验收" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav" IsChecked="{Binding Navigation.IsMatchSetupSelected,Mode=TwoWay}" Command="{Binding Navigation.NavigateMatchSetupCommand}" AutomationProperties.AutomationId="NavigateMatchSetup" AutomationProperties.Name="对局配置">
                            <Grid Width="130"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="PeopleTeam24" FontSize="19"/><TextBlock Grid.Column="1" Text="对局配置" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav" IsChecked="{Binding Navigation.IsCosmeticsSelected,Mode=TwoWay}" Command="{Binding Navigation.NavigateCosmeticsCommand}" AutomationProperties.AutomationId="NavigateCosmetics" AutomationProperties.Name="饰品配置">
                            <Grid Width="130"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="PaintBrush24" FontSize="19"/><TextBlock Grid.Column="1" Text="饰品配置" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="24,20,24,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="返回" Command="{Binding Navigation.ReturnFromSettingsCommand}" Style="{StaticResource GhostButton}" Visibility="{Binding Navigation.IsSettingsSelected,Converter={StaticResource BoolToVis}}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Navigation.PageTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Header.Cs2StatusText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="⚙" Command="{Binding Navigation.NavigateSettingsCommand}" Style="{StaticResource GhostButton}" ToolTip="系统设置" AutomationProperties.AutomationId="NavigateSettings" AutomationProperties.Name="系统设置" FontSize="19"/>
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBgRail}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="24,12" Visibility="{Binding Navigation.IsHumanPage,Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Header.DraftStatusText}" FontSize="12"/>
                            <TextBlock Text="{Binding Cosmetics.StatusMessage}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Cosmetics.StatusMessage}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="放弃修改" Command="{Binding Header.DiscardCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                            <Button Content="保存方案" Command="{Binding Header.SaveCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SaveHumanPreset"/>
                            <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Command="{Binding Header.ApplyCommand}" ToolTip="{Binding Header.ApplyHint}" AutomationProperties.AutomationId="ApplyHumanPreset"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid>
                    <views:MatchSetupView DataContext="{Binding Bot.Setup}" Visibility="{Binding DataContext.Navigation.IsMatchSetupSelected,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolToVis}}"/>
                    <views:CosmeticsConfigurationView Visibility="{Binding Navigation.IsCosmeticsSelected,Converter={StaticResource BoolToVis}}"/>
                    <views:SystemSettingsView Visibility="{Binding Navigation.IsSettingsSelected,Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
