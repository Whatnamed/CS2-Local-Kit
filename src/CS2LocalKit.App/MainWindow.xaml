<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CS2LocalKit.App.Views" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="CS2LocalKit.App.MainWindow" Title="CS2 Local Kit" Width="1280" Height="840" MinWidth="1024" MinHeight="660" WindowStartupLocation="CenterScreen" Background="{StaticResource BrushBgWindow}" UseLayoutRounding="True">
    <Grid Background="{StaticResource BrushBgWindow}">
        <Grid x:Name="LoadingHost">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Games24" FontSize="40" Foreground="{StaticResource BrushAccent}"/>
                <TextBlock Text="CS2 Local Kit" Style="{StaticResource PageTitle}" Margin="0,18,0,8"/>
                <TextBlock x:Name="LoadingText" Text="正在读取本地清单…" Style="{StaticResource HintText}"/>
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="3" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="ShellHost" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource BrushBgRail}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,26,16,24">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Games24" Foreground="{StaticResource BrushAccent}" FontSize="27" Margin="0,0,10,0"/>
                            <TextBlock Text="LOCAL KIT" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="COUNTER-STRIKE 2" FontSize="10" Foreground="{StaticResource BrushTextTertiary}" Margin="38,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,16,18,22">
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="离线 · 本地游玩" FontSize="12"/>
                        <TextBlock Text="运行时效果待游戏内验收" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="工作区" Style="{StaticResource GroupName}" Margin="20,0,0,10"/>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav" IsChecked="{Binding Navigation.IsMatchSetupSelected, Mode=TwoWay}" Command="{Binding Navigation.NavigateMatchSetupCommand}" AutomationProperties.AutomationId="NavigateMatchSetup" AutomationProperties.Name="准备下一局">
                            <Grid Width="140">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="19"/>
                                <TextBlock Grid.Column="1" Text="准备下一局" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav" IsChecked="{Binding Navigation.IsCosmeticsSelected, Mode=TwoWay}" Command="{Binding Navigation.NavigateCosmeticsCommand}" AutomationProperties.AutomationId="NavigateCosmetics" AutomationProperties.Name="真人饰品">
                            <Grid Width="140">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="PaintBrush24" FontSize="19"/>
                                <TextBlock Grid.Column="1" Text="真人饰品" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav" IsChecked="{Binding Navigation.IsPresetsSelected, Mode=TwoWay}" Command="{Binding Navigation.NavigatePresetsCommand}" AutomationProperties.AutomationId="NavigatePresets" AutomationProperties.Name="饰品预设">
                            <Grid Width="140">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Folder24" FontSize="19"/>
                                <TextBlock Grid.Column="1" Text="饰品预设" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav" IsChecked="{Binding Navigation.IsBotSelected, Mode=TwoWay}" Command="{Binding Navigation.NavigateBotCommand}" AutomationProperties.AutomationId="NavigateBot" AutomationProperties.Name="Bot 安装">
                            <Grid Width="140">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="19"/>
                                <TextBlock Grid.Column="1" Text="Bot 安装" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailItem}" GroupName="nav" IsChecked="{Binding Navigation.IsRuntimeStatusSelected, Mode=TwoWay}" Command="{Binding Navigation.NavigateRuntimeStatusCommand}" AutomationProperties.AutomationId="NavigateRuntimeStatus" AutomationProperties.Name="环境与恢复">
                            <Grid Width="140">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="19"/>
                                <TextBlock Grid.Column="1" Text="环境与恢复" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="24,22,24,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Navigation.PageTitle}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding Navigation.PageSubtitle}" Style="{StaticResource HintText}" Margin="0,5,12,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding Navigation.NavigateRuntimeStatusCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Top" ToolTip="查看环境与阻断原因">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding Header.HealthLevel, Converter={StaticResource HealthBrush}}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Header.Cs2StatusText}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBgRail}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="24,12" Visibility="{Binding Navigation.IsHumanPage, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Header.DraftStatusText}" FontSize="12"/>
                            <TextBlock Text="{Binding Cosmetics.StatusMessage}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Cosmetics.StatusMessage}" Visibility="{Binding Cosmetics.IsStatusVisible, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="放弃更改" Command="{Binding Header.DiscardCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                            <Button Content="保存预设" Command="{Binding Header.SaveCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SaveHumanPreset"/>
                            <Button Content="应用到 CS2" Style="{StaticResource PrimaryButton}" Command="{Binding Header.ApplyCommand}" ToolTip="{Binding Header.ApplyHint}" AutomationProperties.AutomationId="ApplyHumanPreset"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Top" Margin="24,0,24,16" Background="{StaticResource BrushBgSurface}" CornerRadius="6" Padding="14,10" Visibility="{Binding Navigation.IsHumanPage, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="编辑草稿" Style="{StaticResource HintText}"/>
                            <TextBlock Text="{Binding Header.EditingName}" Margin="0,3,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Header.EditingName}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="激活指针" Style="{StaticResource HintText}"/>
                            <TextBlock Text="{Binding Header.ActiveName}" Margin="0,3,12,0" TextTrimming="CharacterEllipsis" ToolTip="启动时读取的预设指针；保存不会自动激活或写入游戏文件。"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="已写入的游戏文件" Style="{StaticResource HintText}"/>
                            <TextBlock Text="{Binding Header.InstalledConfigName}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Header.InstalledConfigDetail}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid>
                    <views:MatchSetupView DataContext="{Binding Bot.Setup}" Visibility="{Binding DataContext.Navigation.IsMatchSetupSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:CosmeticsView DataContext="{Binding Cosmetics}" Visibility="{Binding DataContext.Navigation.IsCosmeticsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:PresetsView DataContext="{Binding Presets}" Visibility="{Binding DataContext.Navigation.IsPresetsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:BotView DataContext="{Binding Bot}" Visibility="{Binding DataContext.Navigation.IsBotSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:RuntimeStatusView DataContext="{Binding RuntimeStatus}" Visibility="{Binding DataContext.Navigation.IsRuntimeStatusSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
