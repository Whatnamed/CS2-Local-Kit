<Window x:Class="CS2LocalKit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CS2LocalKit.App.Views"
        Title="CS2 Local Kit" Width="1100" Height="760"
        MinWidth="980" MinHeight="680"
        Background="{StaticResource BrushBgWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="CS2 Local Kit" FontSize="19" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,26,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="当前预设" Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Header.DisplayPresetName}" FontWeight="SemiBold"
                           MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Header.Cs2StatusText}"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,22,0"/>
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                         Fill="{Binding Header.HealthLevel, Converter={StaticResource HealthBrush}}"/>
                <TextBlock Text="{Binding Header.HealthLevel, Converter={StaticResource HealthBadge}}"
                           Foreground="{StaticResource BrushTextSecondary}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,0">
                <Button Content="饰品" Command="{Binding Navigation.NavigateCosmeticsCommand}"
                        Tag="{Binding Navigation.IsCosmeticsSelected}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="预设" Command="{Binding Navigation.NavigatePresetsCommand}"
                        Tag="{Binding Navigation.IsPresetsSelected}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="状态" Command="{Binding Navigation.NavigateRuntimeStatusCommand}"
                        Tag="{Binding Navigation.IsRuntimeStatusSelected}" Style="{StaticResource NavButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <views:CosmeticsView DataContext="{Binding Cosmetics}"
                Visibility="{Binding DataContext.Navigation.IsCosmeticsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            <views:PresetsView DataContext="{Binding Presets}"
                Visibility="{Binding DataContext.Navigation.IsPresetsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            <views:RuntimeStatusView DataContext="{Binding RuntimeStatus}"
                Visibility="{Binding DataContext.Navigation.IsRuntimeStatusSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BrushBgSidebar}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                MinHeight="60"
                Visibility="{Binding Navigation.IsRuntimeStatusSelected, Converter={StaticResource InvBoolToVis}}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="{Binding Header.DraftStatusText}"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding Cosmetics.StatusMessage}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Cosmetics.IsStatusVisible, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="保存" Command="{Binding Header.SaveCommand}" MinWidth="88"
                            Margin="0,0,10,0"/>
                    <Button Content="应用到 CS2" Command="{Binding Header.ApplyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="118"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
