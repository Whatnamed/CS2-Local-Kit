<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CS2LocalKit.App.Views.DecisionWindow" Title="操作确认" Width="580" Height="440" MinWidth="480" MinHeight="340" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BrushBgWindow}">
    <Grid Background="{StaticResource BrushBgWindow}">
        <DockPanel Background="{StaticResource BrushBgWindow}" Margin="24">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" IsCancel="True" Click="CancelClick" Margin="0,0,8,0"/>
                <Button Content="放弃并切换" Click="DiscardClick" Visibility="{Binding IsUnsaved,Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                <Button Content="{Binding AcceptLabel}" Click="AcceptClick" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="AcceptDecision"/>
            </WrapPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="23"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
