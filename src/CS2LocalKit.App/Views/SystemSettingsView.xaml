<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CS2LocalKit.App.Views" x:Class="CS2LocalKit.App.Views.SystemSettingsView">
    <TabControl Margin="24,0,24,16" AutomationProperties.AutomationId="SystemSettingsSections">
        <TabItem Header="组件状态">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="组件状态" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding Bot.CurrentMode}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Bot.InstalledDifficulty,StringFormat='实际强度：{0}'}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Bot.StateText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Bot.ProcessText}" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Panel}"><StackPanel>
                        <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding RuntimeStatus.HealthTitle}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding RuntimeStatus.HealthNextStep}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button Content="检查组件" Command="{Binding RuntimeStatus.RefreshCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="兼容检查">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Panel}"><StackPanel>
                        <TextBlock Text="兼容检查" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding RuntimeStatus.HealthSummary}" TextWrapping="Wrap" Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding RuntimeStatus.PatchVersion,StringFormat='CS2 版本：{0}'}"/>
                        <TextBlock Text="{Binding RuntimeStatus.BuildId,StringFormat='Steam build：{0}'}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RuntimeStatus.MetaModStatus,StringFormat='MetaMod：{0}'}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RuntimeStatus.CssStatus,StringFormat='CounterStrikeSharp：{0}'}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RuntimeStatus.InventorySimulatorStatusText,StringFormat='Human 饰品：{0}'}" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="检查组件" Command="{Binding RuntimeStatus.RefreshCommand}" Margin="0,0,8,8"/>
                            <Button Content="修复启动项" Command="{Binding RuntimeStatus.RepairMetaModStartupCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="备份恢复">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="备份恢复" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding RuntimeStatus.RollbackReason}" TextWrapping="Wrap" Margin="0,12,0,8"/>
                        <Button Content="恢复饰品配置" Command="{Binding RuntimeStatus.RestoreLatestCommand}" HorizontalAlignment="Left"/>
                    </StackPanel></Border>
                    <views:BotView DataContext="{Binding Bot}"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="数据管理">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="对局方案" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="导入方案" Command="{Binding Bot.Setup.ImportCommand}" Margin="0,0,8,8"/>
                            <Button Content="导出方案" Command="{Binding Bot.Setup.ExportCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="饰品方案" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="导入方案" Command="{Binding Presets.ImportCommand}" Margin="0,0,8,8"/>
                            <Button Content="导出方案" Command="{Binding Presets.ExportCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Panel}"><StackPanel>
                        <TextBlock Text="本地物品清单" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CatalogSyncMessage}" TextWrapping="Wrap" Margin="0,10,0,8"/>
                        <Button Content="{Binding CatalogSyncButtonText}" Command="{Binding SyncCatalogCommand}" HorizontalAlignment="Left"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="诊断信息">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Panel}"><StackPanel>
                        <TextBlock Text="诊断信息" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding Bot.CandidateIdentity}" TextWrapping="Wrap" FontFamily="{StaticResource FontMono}" Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding Bot.InstallId,StringFormat='install ID：{0}'}" FontFamily="{StaticResource FontMono}"/>
                        <TextBlock Text="{Binding Bot.BackupPath}" TextWrapping="Wrap" FontFamily="{StaticResource FontMono}" Margin="0,8,0,8"/>
                        <TextBlock Text="{Binding Bot.AvailabilityText}" TextWrapping="Wrap"/>
                        <Button Content="查看诊断位置" Command="{Binding Bot.OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
