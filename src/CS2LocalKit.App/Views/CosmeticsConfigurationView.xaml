<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CS2LocalKit.App.Views" x:Class="CS2LocalKit.App.Views.CosmeticsConfigurationView">
    <DockPanel>
        <Border DockPanel.Dock="Top" Margin="24,0,24,14" Style="{StaticResource Panel}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="饰品方案" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding Header.DraftStatusText}" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                </DockPanel>
                <WrapPanel Margin="0,12,0,0">
                    <ComboBox Width="240" ItemsSource="{Binding Presets.VisiblePresets}" SelectedItem="{Binding Presets.SelectedPreset}" DisplayMemberPath="FriendlyName" Margin="0,0,8,8" AutomationProperties.AutomationId="CosmeticsPlanSelector"/>
                    <Button Content="选择方案" Command="{Binding Presets.LoadPresetCommand}" Margin="0,0,8,8"/>
                    <Button Content="复制方案" Command="{Binding Presets.DuplicateCommand}" Margin="0,0,8,8"/>
                    <Button Content="导入方案" Command="{Binding Presets.ImportCommand}" Margin="0,0,8,8"/>
                    <Button Content="导出方案" Command="{Binding Presets.ExportCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <Expander Header="管理饰品方案">
                    <StackPanel Margin="0,12,0,0">
                        <WrapPanel>
                            <TextBox Width="220" Text="{Binding Presets.NewPresetNameInput,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新饰品方案名称" Margin="0,0,8,8"/>
                            <Button Content="新建方案" Command="{Binding Presets.CreateNewPresetCommand}" Margin="0,0,8,8"/>
                            <Button Content="删除方案" Command="{Binding Presets.DeleteCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Presets.StatusMessage}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <views:CosmeticsView DataContext="{Binding Cosmetics}"/>
    </DockPanel>
</UserControl>
