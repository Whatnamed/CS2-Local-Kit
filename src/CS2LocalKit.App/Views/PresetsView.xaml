<UserControl x:Class="CS2LocalKit.App.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:CS2LocalKit.App.ViewModels"
             Background="Transparent">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Controls -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="预设管理" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="管理本地存储的 HumanPreset 配置文件 (存储路径: E:\CS2MOD\presets\human\)"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="导入预设..."
                            Command="{Binding ImportCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="导出选定..."
                            Command="{Binding ExportCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="刷新列表"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Presets List & Details -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Preset List -->
            <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,12,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding SelectedPreset}"
                             Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                        <TextBlock Text="当前编辑中"
                                                   Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"
                                                   Foreground="#60a5fa"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                            Background="#14532d"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="当前激活" Foreground="#4ade80" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Create New Preset Card -->
                    <Border Grid.Row="1" Background="#18181c" CornerRadius="4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="新建预设:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewPresetNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Content="创建"
                                        Command="{Binding CreateNewPresetCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,4"/>
                            </Grid>
                            <TextBlock Text="将基于稳定模板创建合法预设，并载入编辑器。" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Actions for Selected Preset -->
            <Border Grid.Column="1" Style="{StaticResource CardPanelStyle}" Margin="0" Padding="20">
                <Grid>
                    <StackPanel MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding SelectedPreset, Converter={StaticResource NullToVis}}">

                        <TextBlock Text="{Binding SelectedPreset.Name}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Visibility="{Binding SelectedPreset.IsActive, Converter={StaticResource BoolToVis}}"
                                    Background="#14532d" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="当前激活预设" Foreground="#4ade80" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <Border Visibility="{Binding SelectedPreset.IsWorking, Converter={StaticResource BoolToVis}}"
                                    Background="#1e3a5f" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="当前正在编辑" Foreground="#60a5fa" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <TextBlock Text="操作" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                        <Button Content="打开并在编辑器中查看 / 修改"
                                Command="{Binding LoadPresetCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,8"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="设为当前激活预设 (Set Active)"
                                Command="{Binding SetActiveCommand}"
                                Padding="16,8"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="创建预设副本 (Duplicate)"
                                Command="{Binding DuplicateCommand}"
                                Padding="16,8"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="导出到文件 (Export)"
                                Command="{Binding ExportCommand}"
                                Padding="16,8"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="删除此预设 (Delete)"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,8"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Stretch"/>

                        <TextBlock Text="注: 当前激活中的预设不允许直接删除，需先将其他预设设为激活。"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- If no preset is selected -->
                    <TextBlock Text="请从左侧选择一个预设进行管理"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding SelectedPreset, Converter={StaticResource NotNullToVis}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Feedback Bar -->
        <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Margin="0,12,0,0" Padding="12,10"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{Binding IsStatusSuccess, Converter={StaticResource HealthBrush}}"
                       FontWeight="Medium"/>
        </Border>
    </Grid>
</UserControl>
