<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="CS2LocalKit.App.Views.PresetsView">
    <Grid Margin="24,0,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.85*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="导入" Command="{Binding ImportCommand}"/>
                    <TextBlock Text="预设库" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ui:TextBox Text="{Binding PresetSearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索饰品预设" AutomationProperties.Name="搜索饰品预设" PlaceholderText="搜索预设名称"/>
                <TextBlock Text="选择预设后，载入编辑或设为激活。" Style="{StaticResource HintText}" Margin="0,8,0,14"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock Text="创建空白预设" Style="{StaticResource Label}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="新建" Command="{Binding CreateNewPresetCommand}" Margin="8,0,0,0"/>
                    <ui:TextBox Text="{Binding NewPresetNameInput,UpdateSourceTrigger=PropertyChanged}" ToolTip="新预设名称；同名文件不会覆盖" AutomationProperties.Name="新预设名称" PlaceholderText="新预设名称"/>
                </DockPanel>
                <Button Content="刷新预设库" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource Panel}" Padding="4">
                <Grid>
                    <ListBox ItemsSource="{Binding VisiblePresets}" SelectedItem="{Binding SelectedPreset}" ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.AutomationId="HumanPresetLibrary">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FriendlyName}"/>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="{Binding EmptyLibrary,Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="没有匹配的预设" FontWeight="SemiBold"/>
                        <TextBlock Text="清空搜索，或在下方创建一个。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedPreset.FriendlyName}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="先从左侧选择一个预设" Style="{StaticResource HintText}" Visibility="{Binding SelectedPreset,Converter={StaticResource NullToVis}}"/>
                        <StackPanel Visibility="{Binding SelectedPreset,Converter={StaticResource NotNullToVis}}">
                            <TextBlock Text="{Binding SelectedPreset.Name}" Style="{StaticResource HintText}" Margin="0,6,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="编辑器当前载入"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.IsWorking,Converter={StaticResource TrueFalseText}}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启动时激活指针"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.IsActive,Converter={StaticResource TrueFalseText}}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已写入游戏文件"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.IsInstalled,Converter={StaticResource TrueFalseText}}"/>
                            </Grid>
                            <TextBlock Text="{Binding DataContext.Header.InstalledConfigDetail,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,18,0,0">
                    <Button Content="载入到编辑器" Command="{Binding LoadPresetCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" AutomationProperties.AutomationId="LoadHumanPreset"/>
                    <Button Content="设为激活预设" Command="{Binding SetActiveCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="ActivateHumanPreset"/>
                </WrapPanel>
                <TextBlock Text="载入只替换编辑器草稿；激活只更新启动指针。写入游戏文件须另点「应用到 CS2」。" Style="{StaticResource HintText}" Margin="0,4,0,14"/>
                <WrapPanel>
                    <Button Content="复制" Command="{Binding DuplicateCommand}" Margin="0,0,8,8"/>
                    <Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,8,8"/>
                    <Button Content="删除所选" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,12" Visibility="{Binding IsStatusVisible,Converter={StaticResource BoolToVis}}"/>
                <Expander Header="存储位置与文件证据">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding Manager.Services.PresetsRoot}" Style="{StaticResource MonoText}"/>
                        <TextBlock Text="{Binding DataContext.Header.InstalledHashText,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MonoText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
