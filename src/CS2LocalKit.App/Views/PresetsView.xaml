<UserControl x:Class="CS2LocalKit.App.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="预设" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="导入" Command="{Binding ImportCommand}" Margin="0,0,9,0"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="本地预设" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" AutomationProperties.Name="预设列表"
                             ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="当前编辑" Foreground="{StaticResource BrushAccent}"
                                                   FontSize="11" Margin="0,3,0,0"
                                                   Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="已激活"
                                               Foreground="{StaticResource BrushGreen}" FontSize="11"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="新建预设" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="新预设名称"
                                     Text="{Binding NewPresetNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="新建"
                                    Command="{Binding CreateNewPresetCommand}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding SelectedPreset, Converter={StaticResource NullToVis}}"
                                MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedPreset.Name}" FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <TextBlock Text="当前编辑" Foreground="{StaticResource BrushAccent}"
                                       Visibility="{Binding SelectedPreset.IsWorking, Converter={StaticResource BoolToVis}}"
                                       Margin="0,0,20,0"/>
                            <TextBlock Text="已激活" Foreground="{StaticResource BrushGreen}"
                                       Visibility="{Binding SelectedPreset.IsActive, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button Content="加载到编辑器" Command="{Binding LoadPresetCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                                MinWidth="150" Margin="0,0,0,10"/>
                        <Button Content="设为激活预设" Command="{Binding SetActiveCommand}"
                                HorizontalAlignment="Left" MinWidth="150" Margin="0,0,0,24"/>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                                Padding="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="复制" Command="{Binding DuplicateCommand}" Margin="0,0,9,0"/>
                                <Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,9,0"/>
                                <Button Content="删除" Command="{Binding DeleteCommand}"
                                        Style="{StaticResource DangerButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="从左侧选择预设" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedPreset, Converter={StaticResource NotNullToVis}}"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,12,0,0"
                   Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
