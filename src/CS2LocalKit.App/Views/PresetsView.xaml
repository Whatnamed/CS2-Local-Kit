<UserControl x:Class="CS2LocalKit.App.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <Grid Margin="28,4,28,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="336"/>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- preset library -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource CompactInput}" MinHeight="34"
                                 Text="{Binding NewPresetNameInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="新预设名称" FontSize="12" Margin="10,0,0,0"
                                   Foreground="{StaticResource BrushTextDisabled}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewPresetNameInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Content="新建" MinWidth="66"
                            Command="{Binding CreateNewPresetCommand}"/>
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Margin="0,7,0,0"
                           Text="名称会自动补全为 .v1.json；新建不会覆盖同名文件。"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,14,8">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="共 "/>
                    <Run Text="{Binding Presets.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=" 个预设"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="导入" Style="{StaticResource GhostButton}" Command="{Binding ImportCommand}"/>
                    <Button Content="刷新" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                            Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BrushBgSurface}" CornerRadius="11" Padding="4" Margin="0,0,14,0">
                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ListRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FriendlyName}" FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                               Foreground="{StaticResource BrushTextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="编辑" FontSize="10.5" Foreground="{StaticResource BrushAccent}"
                                               Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="游戏内" FontSize="10.5" Foreground="{StaticResource BrushSuccess}"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource VerticalDivider}"/>

        <!-- selected preset: three distinct facts, kept separate on purpose -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding SelectedPreset.FriendlyName}" Style="{StaticResource PageTitle}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding SelectedPreset, Converter={StaticResource NotNullToVis}}"/>
                <TextBlock Text="{Binding SelectedPreset.Name}" Style="{StaticResource MonoText}"
                           Margin="0,4,0,0"
                           Visibility="{Binding SelectedPreset, Converter={StaticResource NotNullToVis}}"/>
                <TextBlock Text="从左侧选择一个预设" Style="{StaticResource HintText}"
                           Visibility="{Binding SelectedPreset, Converter={StaticResource NullToVis}}"/>

                <StackPanel Margin="0,20,0,0" Visibility="{Binding SelectedPreset, Converter={StaticResource NotNullToVis}}">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="正在编辑" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="{Binding SelectedPreset.IsWorking, Converter={StaticResource TrueFalseText}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                               Text="编辑器里的草稿；未保存的更改只存在于内存，写入文件需要点“保存预设”。"
                               Visibility="{Binding SelectedPreset.IsWorking, Converter={StaticResource BoolToVis}}"/>

                    <Border Style="{StaticResource Divider}" Margin="0,8"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="激活预设" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="{Binding SelectedPreset.IsActive, Converter={StaticResource TrueFalseText}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                               Text="InventorySimulator 启动时读取的指针；它与“游戏内配置”可能不同，例如手动改过文件之后。"/>

                    <Border Style="{StaticResource Divider}" Margin="0,8"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="游戏内配置" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="{Binding SelectedPreset.IsInstalled, Converter={StaticResource TrueFalseText}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="{Binding DataContext.Header.InstalledConfigDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                               TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource MonoText}" Margin="0,4,0,0"
                               Text="{Binding DataContext.Header.InstalledHashText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Visibility="{Binding SelectedPreset.IsInstalled, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Border Style="{StaticResource Divider}"/>

                <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedPreset, Converter={StaticResource NotNullToVis}}">
                    <Button Content="载入到编辑器" Style="{StaticResource PrimaryButton}" MinWidth="112"
                            Command="{Binding LoadPresetCommand}"/>
                    <Button Content="设为激活预设" MinWidth="112" Margin="10,0,0,0"
                            Command="{Binding SetActiveCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding SelectedPreset, Converter={StaticResource NotNullToVis}}">
                    <Button Content="复制" Style="{StaticResource GhostButton}" Command="{Binding DuplicateCommand}"/>
                    <Button Content="导出" Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}"
                            Margin="8,0,0,0"/>
                    <Button Content="删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"
                            Margin="8,0,0,0"/>
                </StackPanel>

                <Border Background="{StaticResource BrushBgSurface}" CornerRadius="9" Padding="13,11" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="存储位置" FontSize="11.5" Foreground="{StaticResource BrushTextTertiary}"/>
                        <TextBlock Style="{StaticResource MonoText}" Margin="0,4,0,0"
                                   Text="{Binding Manager.Services.PresetsRoot}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="预设是本工具拥有的文件；应用时才会投影到 CS2 的运行配置。"/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                           Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
