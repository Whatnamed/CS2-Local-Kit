<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="CS2LocalKit.App.Views.MatchSetupView" UseLayoutRounding="True">
    <UserControl.Resources>
        <DataTemplate x:Key="RosterEditor">
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="本局队名；只修改草稿" AutomationProperties.Name="本局队名" FontSize="17" FontWeight="SemiBold" Background="Transparent" BorderThickness="0,0,0,1"/>
                        <Button Grid.Column="1" Content="混编" Command="{Binding RandomizeCommand}" Margin="8,0,0,0" ToolTip="从可用选手中随机组成五人阵容"/>
                    </Grid>
                    <TabControl AutomationProperties.Name="阵容编辑方式">
                        <TabItem Header="席位">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="64"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}" Style="{StaticResource HintText}" Width="24" TextWrapping="NoWrap" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" Padding="8,4" MinHeight="30"/>
                                                        <TextBlock Text="{Binding PersonaHint}" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}" Margin="2,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PersonaHint}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Participation}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Participation}" Value="我 · 真人">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Participation}" Value="不出场">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="在「选手库」中绑定明确身份；直接改名会移除 persona 绑定。" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="战队">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,12,0,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Content="全部 40 队" IsChecked="{Binding ShowAll}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding TeamQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索队伍名称" AutomationProperties.Name="搜索队伍" PlaceholderText="搜索战队" ClearButtonEnabled="True"/>
                                    </DockPanel>
                                    <ComboBox ItemsSource="{Binding Teams}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding TeamId}" AutomationProperties.Name="队伍" Margin="0,8,0,6"/>
                                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" DisplayMemberPath="Label" AutomationProperties.Name="阵容版本" ToolTip="历史阵容版本；内置快照只读" Margin="0,0,0,12" IsEnabled="{Binding HasVersions}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="选手库">
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="搜索名称 / 完整 persona ID" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding PlayerQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索选手"/>
                                    <TextBlock Text="{Binding PlayerResultText}" Style="{StaticResource HintText}" Margin="0,6,0,10"/>
                                </StackPanel>
                                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding SeatChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedSeat}" AutomationProperties.Name="待替换席位"/>
                                    <Button Grid.Column="1" Content="替换席位" Command="{Binding ReplaceCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" AutomationProperties.Name="替换席位"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}" ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.Name="选手搜索结果">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Player.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Number}" Style="{StaticResource HintText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" FontFamily="{StaticResource FontMono}" TextWrapping="NoWrap" Width="24"/>
                                                <TextBlock Text="身份已停用 · 不可绑定" Foreground="{StaticResource BrushWarning}" FontSize="11" Visibility="{Binding Player.Enabled, Converter={StaticResource InvBoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="自定义">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="个人阵容名称" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" ToolTip="自定义阵容名称"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="从本局新建" Command="{Binding NewCustomCommand}" Margin="0,0,6,6"/>
                                        <Button Content="复制" Command="{Binding CopyCustomCommand}" Margin="0,0,6,6"/>
                                        <Button Content="保存 / 重命名" Command="{Binding SaveCustomCommand}" Margin="0,0,6,6"/>
                                        <Button Content="导出阵容" Command="{Binding ExportRosterCommand}" Margin="0,0,6,6"/>
                                        <Button Content="删除个人副本" Command="{Binding DeleteCustomCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <TextBlock Text="来源与版本" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="24,0,24,0">
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding DraftState}" FontSize="12" AutomationProperties.AutomationId="MatchDraftState"/>
                    <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource BrushWarning}" TextWrapping="Wrap" MaxHeight="42" AutomationProperties.AutomationId="MatchSetupFeedback"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="保存方案" Command="{Binding SaveCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SaveMatchPreset"/>
                    <Button Content="{Binding PrepareActionText}" Command="{Binding DataContext.Bot.PrepareMatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanPrepareAction}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrepareMatch"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="基础设置" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,12,12"><TextBlock Text="地图" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MapChoices}" IsEditable="True" Text="{Binding Map,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MatchMap"/></StackPanel>
                            <StackPanel Margin="0,0,12,12"><TextBlock Text="模式" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.AutomationId="MatchMode"/></StackPanel>
                            <StackPanel Margin="0,0,0,12"><TextBlock Text="难度" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding DifficultyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile}" AutomationProperties.AutomationId="MatchProfile"/></StackPanel>
                            <StackPanel Margin="0,0,12,12"><TextBlock Text="瞄准" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding AimLabels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Aim}" AutomationProperties.AutomationId="MatchAim"/></StackPanel>
                            <StackPanel Margin="0,0,12,12"><TextBlock Text="道具" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding NadeLabels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Nades}" AutomationProperties.AutomationId="MatchNades"/></StackPanel>
                            <StackPanel Margin="0,0,0,12"><TextBlock Text="我的阵营" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding SideChoices}" SelectedItem="{Binding HumanSide}" AutomationProperties.AutomationId="MatchHumanSide"/></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="我方 Bot" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding FriendlyCounts}" SelectedItem="{Binding FriendlyBots}" AutomationProperties.AutomationId="MatchFriendlyCount"/></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="对方 Bot" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding EnemyCounts}" SelectedItem="{Binding EnemyBots}" AutomationProperties.AutomationId="MatchEnemyCount"/></StackPanel>
                            <StackPanel><TextBlock Text="我替代的席位" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ReplacementChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReplacedSlot}" AutomationProperties.AutomationId="MatchReplacement"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="交换阵容" Command="{Binding SwapLineupsCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SwapLineups"/>
                                <Button Content="撤销交换" Command="{Binding UndoSwapCommand}" AutomationProperties.AutomationId="UndoSwapLineups"/>
                            </StackPanel>
                            <TextBlock Text="双方阵容" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel Margin="0,16,0,0">
                            <StackPanel Width="370" Margin="0,0,14,14"><TextBlock Text="{Binding FriendlySummary}" FontWeight="SemiBold" Margin="0,0,0,8"/><ContentControl Content="{Binding Friendly}" ContentTemplate="{StaticResource RosterEditor}"/></StackPanel>
                            <StackPanel Width="370" Margin="0,0,0,14"><TextBlock Text="{Binding EnemySummary}" FontWeight="SemiBold" Margin="0,0,0,8"/><ContentControl Content="{Binding Enemy}" ContentTemplate="{StaticResource RosterEditor}"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" AutomationProperties.AutomationId="MatchLineupPreview"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="对局方案" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Margin="0,12,0,8">
                            <ComboBox Width="230" ItemsSource="{Binding Presets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPreset}" AutomationProperties.AutomationId="MatchPresetSelector" Margin="0,0,8,8"/>
                            <Button Content="选择方案" Command="{Binding LoadCommand}" Margin="0,0,8,8"/>
                            <Button Content="新建方案" Command="{Binding NewCommand}" Margin="0,0,8,8"/>
                            <Button Content="复制方案" Command="{Binding DuplicateCommand}" Margin="0,0,8,8"/>
                            <Button Content="删除方案" Command="{Binding DeleteCommand}" Margin="0,0,8,8"/>
                            <Button Content="导入方案" Command="{Binding ImportCommand}" Margin="0,0,8,8"/>
                            <Button Content="导出方案" Command="{Binding ExportCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="方案名称"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel><Button DockPanel.Dock="Right" Content="检查状态" Command="{Binding RefreshStatusCommand}"/><TextBlock Text="准备状态" Style="{StaticResource SectionTitle}"/></DockPanel>
                        <TextBlock Text="{Binding PreparationText}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.AutomationId="MatchPreparationStatus"/>
                        <TextBlock Text="{Binding ApplyStatus}" TextWrapping="Wrap" Style="{StaticResource HintText}" AutomationProperties.AutomationId="MatchApplyStatus"/>
                        <TextBlock Text="{Binding DataContext.Bot.Feedback,RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Foreground="{StaticResource BrushWarning}" Margin="0,8,0,0"/>
                        <TextBlock Text="可靠的一键启动尚未实机证实。准备后由本人以 -insecure 启动离线 CS2 并加载所选地图；运行时读回后再确认本局状态。" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
