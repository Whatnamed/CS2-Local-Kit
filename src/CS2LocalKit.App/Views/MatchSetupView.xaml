<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="CS2LocalKit.App.Views.MatchSetupView" UseLayoutRounding="True">
    <UserControl.Resources>
        <DataTemplate x:Key="RosterEditor">
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="本局队名；只修改草稿" AutomationProperties.Name="本局队名" FontSize="17" FontWeight="SemiBold" Background="Transparent" BorderThickness="0,0,0,1"/>
                        <Button Grid.Column="1" Content="混编" Command="{Binding RandomizeCommand}" Margin="8,0,0,0" ToolTip="从可用选手中随机组成五人阵容"/>
                    </Grid>
                    <TabControl AutomationProperties.Name="阵容编辑方式">
                        <TabItem Header="席位">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="64"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}" Style="{StaticResource HintText}" Width="24" TextWrapping="NoWrap" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" Padding="8,4" MinHeight="30"/>
                                                        <TextBlock Text="{Binding PersonaHint}" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}" Margin="2,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PersonaHint}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Participation}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Participation}" Value="我 · 真人">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Participation}" Value="不出场">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="在「选手库」中绑定明确身份；直接改名会移除 persona 绑定。" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="战队">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,12,0,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Content="全部 40 队" IsChecked="{Binding ShowAll}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding TeamQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索队伍名称" AutomationProperties.Name="搜索队伍" PlaceholderText="搜索战队" ClearButtonEnabled="True"/>
                                    </DockPanel>
                                    <ComboBox ItemsSource="{Binding Teams}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding TeamId}" AutomationProperties.Name="队伍" Margin="0,8,0,6"/>
                                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" DisplayMemberPath="Label" AutomationProperties.Name="阵容版本" ToolTip="历史阵容版本；内置快照只读" Margin="0,0,0,12" IsEnabled="{Binding HasVersions}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="选手库">
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="搜索名称 / 完整 persona ID" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding PlayerQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索选手"/>
                                    <TextBlock Text="{Binding PlayerResultText}" Style="{StaticResource HintText}" Margin="0,6,0,10"/>
                                </StackPanel>
                                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding SeatChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedSeat}" AutomationProperties.Name="待替换席位"/>
                                    <Button Grid.Column="1" Content="替换席位" Command="{Binding ReplaceCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" AutomationProperties.Name="替换席位"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}" ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.Name="选手搜索结果">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Player.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Number}" Style="{StaticResource HintText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" FontFamily="{StaticResource FontMono}" TextWrapping="NoWrap" Width="24"/>
                                                <TextBlock Text="身份已停用 · 不可绑定" Foreground="{StaticResource BrushWarning}" FontSize="11" Visibility="{Binding Player.Enabled, Converter={StaticResource InvBoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="自定义">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="个人阵容名称" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" ToolTip="自定义阵容名称"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="从本局新建" Command="{Binding NewCustomCommand}" Margin="0,0,6,6"/>
                                        <Button Content="复制" Command="{Binding CopyCustomCommand}" Margin="0,0,6,6"/>
                                        <Button Content="保存 / 重命名" Command="{Binding SaveCustomCommand}" Margin="0,0,6,6"/>
                                        <Button Content="导出阵容" Command="{Binding ExportRosterCommand}" Margin="0,0,6,6"/>
                                        <Button Content="删除个人副本" Command="{Binding DeleteCustomCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <TextBlock Text="来源与版本" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="24,0,24,0">
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding DraftState}" FontSize="12" AutomationProperties.AutomationId="MatchDraftState"/>
                    <TextBlock Text="{Binding Feedback}" Style="{StaticResource HintText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Feedback}" Foreground="{StaticResource BrushWarning}" AutomationProperties.AutomationId="MatchSetupFeedback"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="保存预设" Command="{Binding SaveCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SaveMatchPreset"/>
                    <Button Content="保存为下局" Command="{Binding QueueCommand}" Style="{StaticResource PrimaryButton}" ToolTip="保存独立快照并排队；不会改变当前地图，也不会安装运行时。" AutomationProperties.AutomationId="QueueMatchSetup"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl AutomationProperties.AutomationId="MatchWorkspaceTabs">
            <TabItem Header="双方阵容">
                <DockPanel Margin="0,14,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="我的阵营" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding SideChoices}" SelectedItem="{Binding HumanSide}" AutomationProperties.AutomationId="MatchHumanSide"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="我方 Bot 人数" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding FriendlyCounts}" SelectedItem="{Binding FriendlyBots}" AutomationProperties.AutomationId="MatchFriendlyCount"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="敌方 Bot 人数" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding EnemyCounts}" SelectedItem="{Binding EnemyBots}" AutomationProperties.AutomationId="MatchEnemyCount"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="我替代的席位" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding ReplacementChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding ReplacedSlot}" AutomationProperties.AutomationId="MatchReplacement"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding FriendlySummary}" DockPanel.Dock="Right" Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="我方" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="{Binding EnemySummary}" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="敌方" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ContentControl Grid.Row="1" Content="{Binding Friendly}" ContentTemplate="{StaticResource RosterEditor}"/>
                        <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding Enemy}" ContentTemplate="{StaticResource RosterEditor}"/>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="规则与应用状态">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Bot 行为" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="预设需要的安装强度" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding Profile}" AutomationProperties.AutomationId="MatchProfile"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="瞄准优先" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding AimChoices}" SelectedItem="{Binding Aim}" AutomationProperties.AutomationId="MatchAim"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="道具策略" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding NadeChoices}" SelectedItem="{Binding Nades}" AutomationProperties.AutomationId="MatchNades"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="强度须匹配实际安装 profile，不会局内热切。Aim / Nades 在适配层就绪后应用并读回。" Style="{StaticResource HintText}"/>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="最终出场阵容" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,12,0,16" AutomationProperties.AutomationId="MatchLineupPreview"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="刷新读回" Command="{Binding RefreshStatusCommand}"/>
                                    <TextBlock Text="运行时接收与行为证据" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding ApplyStatus}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.AutomationId="MatchApplyStatus"/>
                                <Border Style="{StaticResource Divider}"/>
                                <TextBlock Text="保存 → 排队 → 运行时接收 / 读回 → 内部行为观察"/>
                                <TextBlock Text="每一步分别记录。本局与上次会话分开；实际玩法仍需实机验收。配置只在新本地地图、插件就绪且计分开始前初始化一次。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="整局预设">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Filters}" SelectedIndex="{Binding PresetFilter}" AutomationProperties.Name="预设筛选"/>
                            <Button Grid.Column="1" Content="载入" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.AutomationId="MatchPresetPicker"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="编辑中的整局预设" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
                            <TextBlock Text="预设名称" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MatchPresetName"/>
                            <CheckBox Content="收藏这个预设" IsChecked="{Binding Favorite}" Margin="0,14,0,14"/>
                            <WrapPanel>
                                <Button Content="新建" Command="{Binding NewCommand}" Margin="0,0,8,8"/>
                                <Button Content="复制当前草稿" Command="{Binding DuplicateCommand}" Margin="0,0,8,8"/>
                                <Button Content="复用上局" Command="{Binding ReuseLastCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <WrapPanel>
                                <Button Content="导入" Command="{Binding ImportCommand}" Margin="0,0,8,8"/>
                                <Button Content="导出全部" Command="{Binding ExportCommand}" Margin="0,0,8,8"/>
                                <Button Content="删除所选" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <TextBlock Text="预设保留双方阵容、人数、替代位置与行为规则。保存只写个人目录；保存为下局才会排队。" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
