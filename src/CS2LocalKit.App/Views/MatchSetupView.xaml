<UserControl x:Class="CS2LocalKit.App.Views.MatchSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <DataTemplate x:Key="RosterEditor">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="全部队伍" IsChecked="{Binding ShowAll}" Margin="12,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding TeamQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索完整 40 队列表" AutomationProperties.Name="搜索队伍"/>
                </DockPanel>
                <ComboBox ItemsSource="{Binding Teams}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding TeamId}" AutomationProperties.Name="队伍" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" DisplayMemberPath="Label" AutomationProperties.Name="阵容版本" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="本局队伍名称" AutomationProperties.Name="本局队名" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactInput}" TextAlignment="Left" AutomationProperties.Name="{Binding Label}"/>
                                    <TextBlock Text="{Binding PersonaHint}" Style="{StaticResource HintText}" FontSize="11" Margin="1,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,6,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding PlayerQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索选手名称或 persona ID，重名时选择明确 ID" AutomationProperties.Name="搜索选手"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SeatChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedSeat}" Margin="8,0,0,0" AutomationProperties.Name="待替换席位"/>
                </Grid>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="替换" Command="{Binding ReplaceCommand}" Margin="8,0,0,0"/>
                    <ComboBox ItemsSource="{Binding Personas}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPersona}" AutomationProperties.Name="选手 persona"/>
                </DockPanel>
                <Button Content="随机混编五人" Command="{Binding RandomizeCommand}" HorizontalAlignment="Left"/>
                <Expander Header="来源与自定义阵容" Margin="0,10,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" ToolTip="自定义阵容名称" Margin="0,10,0,6"/>
                        <WrapPanel>
                            <Button Content="从本局新建" Command="{Binding NewCustomCommand}" Margin="0,0,6,6"/>
                            <Button Content="复制" Command="{Binding CopyCustomCommand}" Margin="0,0,6,6"/>
                            <Button Content="保存 / 重命名" Command="{Binding SaveCustomCommand}" Margin="0,0,6,6"/>
                            <Button Content="删除" Command="{Binding DeleteCustomCommand}" Margin="0,0,6,6"/>
                            <Button Content="导出阵容" Command="{Binding ExportRosterCommand}" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="刷新应用状态" Command="{Binding RefreshStatusCommand}" Margin="10,0,0,0"/>
            <TextBlock Text="本局阵容" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Background="{StaticResource BrushBgSurface}" Padding="14" CornerRadius="8" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding ApplyStatus}" TextWrapping="Wrap" AutomationProperties.AutomationId="MatchApplyStatus"/>
                <TextBlock Text="{Binding DraftState}" Style="{StaticResource HintText}" Margin="0,6,0,0" AutomationProperties.AutomationId="MatchDraftState"/>
                <TextBlock Text="保存与安装分开。配置只在新本地地图、插件就绪且计分开始前自动应用；本局不热切强度。" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Expander Header="整局预设 · 最近 / 收藏 / 导入导出" Margin="0,0,0,14">
        <StackPanel Margin="0,10,0,0">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Filters}" SelectedIndex="{Binding PresetFilter}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Label" Margin="8,0" AutomationProperties.AutomationId="MatchPresetPicker"/>
            <Button Grid.Column="2" Content="载入" Command="{Binding LoadCommand}"/>
        </Grid>
        <DockPanel Margin="0,0,0,8">
            <CheckBox DockPanel.Dock="Right" Content="收藏" IsChecked="{Binding Favorite}" Margin="10,0,0,0"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MatchPresetName" ToolTip="整局预设名称"/>
        </DockPanel>
        <WrapPanel Margin="0,0,0,14">
            <Button Content="新建" Command="{Binding NewCommand}" Margin="0,0,6,6"/>
            <Button Content="复制" Command="{Binding DuplicateCommand}" Margin="0,0,6,6"/>
            <Button Content="保存预设" Command="{Binding SaveCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="SaveMatchPreset"/>
            <Button Content="删除所选" Command="{Binding DeleteCommand}" Margin="0,0,6,6"/>
            <Button Content="复用上局" Command="{Binding ReuseLastCommand}" Margin="0,0,6,6"/>
            <Button Content="导入" Command="{Binding ImportCommand}" Margin="0,0,6,6"/>
            <Button Content="导出全部" Command="{Binding ExportCommand}" Margin="0,0,6,6"/>
        </WrapPanel>
        </StackPanel>
        </Expander>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="我的阵营" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding SideChoices}" SelectedItem="{Binding HumanSide}" AutomationProperties.AutomationId="MatchHumanSide"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="我方 Bot" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding FriendlyCounts}" SelectedItem="{Binding FriendlyBots}" AutomationProperties.AutomationId="MatchFriendlyCount"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="敌方 Bot" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding EnemyCounts}" SelectedItem="{Binding EnemyBots}" AutomationProperties.AutomationId="MatchEnemyCount"/></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="我替代" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding ReplacementChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding ReplacedSlot}" AutomationProperties.AutomationId="MatchReplacement"/></StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="我方" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><ContentControl Content="{Binding Friendly}" ContentTemplate="{StaticResource RosterEditor}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="敌方" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><ContentControl Content="{Binding Enemy}" ContentTemplate="{StaticResource RosterEditor}"/></StackPanel>
        </Grid>
        <TextBlock Text="Bot 行为" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="预设需要的安装强度" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding Profile}" AutomationProperties.AutomationId="MatchProfile"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="瞄准优先" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding AimChoices}" SelectedItem="{Binding Aim}" AutomationProperties.AutomationId="MatchAim"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="道具策略" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding NadeChoices}" SelectedItem="{Binding Nades}" AutomationProperties.AutomationId="MatchNades"/></StackPanel>
        </Grid>
        <TextBlock Text="强度必须与实际安装 profile 一致；选项不会热切 DLL 或 profile。Aim/Nades 在适配层就绪后应用并读回，行为仍需实机对照。" Style="{StaticResource HintText}" Margin="0,8,0,12"/>
        <Border Background="{StaticResource BrushBgSurface}" CornerRadius="8" Padding="14" Margin="0,0,0,12"><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" AutomationProperties.AutomationId="MatchLineupPreview"/></Border>
        <Button Content="保存为下局 · 开局自动应用" Command="{Binding QueueCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="QueueMatchSetup"/>
        <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{StaticResource BrushWarning}" Margin="0,10,0,16" AutomationProperties.AutomationId="MatchSetupFeedback"/>
    </StackPanel>
</UserControl>
