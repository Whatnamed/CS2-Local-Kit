<UserControl x:Class="CS2LocalKit.App.Views.BotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,4,28,24">
            <Border Background="{StaticResource BrushBgSurface}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProcessText}" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Margin="0,10,0,0" Text="{Binding CurrentMode}" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="CurrentLocalMode"/>
                    <TextBlock Margin="0,7,0,0" Text="{Binding HumanStatusText}" Style="{StaticResource HintText}"/>
                    <TextBlock Margin="0,7,0,0" Text="两种模式都用于离线本地游玩；文件安装态不等于游戏内效果已验收。" Style="{StaticResource HintText}"/>
                    <TextBlock Margin="0,6,0,0" Text="{Binding TargetBuild}" Style="{StaticResource HintText}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="切换本地模式" Style="{StaticResource SectionTitle}" Margin="0,24,0,12"/>
            <ComboBox AutomationProperties.AutomationId="TargetLocalMode" ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TargetMode}" IsEnabled="{Binding CanSelectMode}"/>
            <TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap" Foreground="{StaticResource BrushWarning}" Margin="0,10,0,8" AutomationProperties.AutomationId="JointModeAvailability"/>
            <TextBlock Text="{Binding ActionHint}" Style="{StaticResource HintText}" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button Content="刷新状态" Command="{Binding RefreshCommand}" Margin="0,0,10,8"/>
                <Button Content="检查切换预览" Command="{Binding PreviewModeCommand}" Margin="0,0,10,8" AutomationProperties.AutomationId="PreviewLocalMode"/>
                <Button Content="{Binding SwitchButtonText}" Command="{Binding SwitchModeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" AutomationProperties.AutomationId="ApplyLocalMode"/>
            </WrapPanel>
            <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{StaticResource BrushWarning}" AutomationProperties.AutomationId="BotFeedback"/>

            <TextBlock Text="增强人机设置" Style="{StaticResource SectionTitle}" Margin="0,20,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="难度 · 安装时选择" Margin="0,0,0,8"/>
                    <ComboBox AutomationProperties.AutomationId="BotDifficulty" ItemsSource="{Binding DifficultyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Difficulty}" IsEnabled="{Binding CanSelectDifficulty}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="瞄准优先 · 待执行" Margin="0,0,0,8"/>
                    <ComboBox AutomationProperties.AutomationId="BotAim" ItemsSource="{Binding AimChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Aim}" IsEnabled="{Binding CanEditCommands}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="道具使用 · 待执行" Margin="0,0,0,8"/>
                    <ComboBox AutomationProperties.AutomationId="BotNades" ItemsSource="{Binding NadesChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Nades}" IsEnabled="{Binding CanEditCommands}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding DifficultyHint}" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
            <TextBlock Text="瞄准与道具选择只生成控制台命令，须在本地游戏中执行；Head 在 Windows listen-server 上待实机验证。道具档位控制 Bot 投掷策略。" Style="{StaticResource HintText}" Margin="0,6,0,12"/>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="复制本局设置命令" Command="{Binding CopyCommandsCommand}" Margin="12,0,0,0"/>
                <TextBox IsReadOnly="True" Text="{Binding ConsoleCommands, Mode=OneWay}" VerticalContentAlignment="Center" AutomationProperties.AutomationId="BotConsoleCommands"/>
            </DockPanel>

            <TextBlock Text="候选与精确恢复" Style="{StaticResource SectionTitle}" Margin="0,24,0,12"/>
            <TextBlock Text="{Binding CandidateIdentity}" Style="{StaticResource MonoText}" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button Content="检查恢复条件" Command="{Binding DiagnosticsCommand}" Margin="0,0,10,8"/>
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="安装的难度" Style="{StaticResource MutedText}"/>
                <TextBlock Grid.Column="1" Text="{Binding InstalledDifficulty}"/>
                <TextBlock Grid.Row="1" Text="install ID" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstallId}" Style="{StaticResource MonoText}" Margin="0,7,0,0"/>
                <TextBlock Grid.Row="2" Text="精确备份" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BackupPath}" Style="{StaticResource MonoText}" Margin="0,7,0,0"/>
            </Grid>
            <WrapPanel Margin="0,12,0,12">
                <Button Content="查看日志位置" Command="{Binding OpenLogsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                <Button Content="查看备份位置" Command="{Binding OpenBackupCommand}" Style="{StaticResource GhostButton}"/>
            </WrapPanel>
            <Expander Header="完整安装 / 恢复文件清单">
                <TextBox Text="{Binding PlanText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="220"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
