<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CS2LocalKit.App.Views.BotView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,24">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProcessText}" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="实际安装" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CurrentMode}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.AutomationId="CurrentLocalMode"/>
                    <TextBlock Text="{Binding InstalledDifficulty, StringFormat='已安装强度：{0}'}"/>
                    <TextBlock Text="{Binding HumanStatusText}" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="准备与恢复" Style="{StaticResource SectionTitle}" Margin="0,24,0,6"/>
            <TextBlock Text="选择偏好不会安装文件。先检查预览，再确认写入范围。" Style="{StaticResource HintText}" Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="下一次切换到" Style="{StaticResource Label}"/>
                    <ComboBox AutomationProperties.AutomationId="TargetLocalMode" ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TargetMode}" IsEnabled="{Binding CanSelectMode}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="安装强度" Style="{StaticResource Label}"/>
                    <ComboBox AutomationProperties.AutomationId="BotDifficulty" ItemsSource="{Binding DifficultyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Difficulty}" IsEnabled="{Binding CanSelectDifficulty}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding DifficultyHint}" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
            <Border Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushAccentBorder}" BorderThickness="3,0,0,0" Padding="14" Margin="0,20,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AvailabilitySummary}" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.AutomationId="JointModeAvailability"/>
                    <TextBlock Text="{Binding ActionSummary}" Style="{StaticResource HintText}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <WrapPanel>
                <Button Content="刷新状态" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/>
                <Button Content="1 · 检查切换预览" Command="{Binding PreviewModeCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="PreviewLocalMode"/>
                <Button Content="{Binding SwitchButtonText}" Command="{Binding SwitchModeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" AutomationProperties.AutomationId="ApplyLocalMode"/>
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,8,0,8"/>
            <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{StaticResource BrushWarning}" AutomationProperties.AutomationId="BotFeedback" Margin="0,8,0,12"/>
            <Expander Header="阻断详情与完整原因" Margin="0,0,0,10">
                <TextBox Text="{Binding AvailabilityText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="180" Margin="0,12,0,0"/>
            </Expander>
            <Expander Header="2 · 检视文件清单与操作预览" Margin="0,0,0,10">
                <TextBox Text="{Binding PlanText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="240" FontFamily="{StaticResource FontMono}" Margin="0,10,0,0"/>
            </Expander>
            <Expander Header="精确恢复与备份">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="{Binding RestoreSummary}" Style="{StaticResource HintText}"/>
                    <TextBlock Text="{Binding InstallId, StringFormat='install ID：{0}'}" Style="{StaticResource MonoText}" Margin="0,12,0,8"/>
                    <TextBlock Text="{Binding BackupPath}" Style="{StaticResource MonoText}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="检查恢复条件" Command="{Binding DiagnosticsCommand}" Margin="0,0,8,8"/>
                        <Button Content="精确恢复此事务" Command="{Binding RestoreCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" AutomationProperties.AutomationId="RestoreBotTransaction"/>
                        <Button Content="查看备份位置" Command="{Binding OpenBackupCommand}" Margin="0,0,8,8"/>
                        <Button Content="查看日志位置" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <Expander Header="高级 · 候选身份与手动诊断" Margin="0,10,0,0">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="{Binding TargetBuild}" Style="{StaticResource MonoText}"/>
                    <TextBlock Text="{Binding CandidateIdentity}" Style="{StaticResource MonoText}" Margin="0,12,0,12"/>
                    <TextBlock Text="下列命令只作手动诊断回退；复制不代表游戏已接收或行为已验证。正常开局规则在「准备下一局」中编辑。" Style="{StaticResource HintText}"/>
                    <TextBox Text="{Binding ConsoleCommands, Mode=OneWay}" IsReadOnly="True" Margin="0,12,0,8" AutomationProperties.AutomationId="BotConsoleCommands"/>
                    <Button Content="复制诊断命令" Command="{Binding CopyCommandsCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
