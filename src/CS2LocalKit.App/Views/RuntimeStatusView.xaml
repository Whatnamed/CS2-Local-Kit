<UserControl x:Class="CS2LocalKit.App.Views.RuntimeStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Label and value share one cell, so the value keeps a left reserve instead of wrapping
             over the label; long paths and hashes trim. -->
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="176,0,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="FieldHash" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="176,0,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource SizeSubtitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,20" MaxWidth="1080" HorizontalAlignment="Center">

            <!-- health -->
            <Border Background="{StaticResource BrushBgSurface}" CornerRadius="12" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{Binding HealthLevel, Converter={StaticResource HealthBrush}}"/>
                            <TextBlock Text="{Binding HealthSummary}" Style="{StaticResource GroupTitle}" Margin="0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Status.BlockedReasons}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource BrushDanger}"
                                               FontSize="12" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Status.AttentionReasons}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource BrushWarning}"
                                               FontSize="12" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="刷新状态" Command="{Binding RefreshCommand}"/>
                        <Button Content="恢复上一次应用" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                                Command="{Binding RestoreLatestCommand}">
                            <Button.ToolTip>
                                <TextBlock MaxWidth="260" Text="{Binding RollbackReason}" TextWrapping="Wrap"/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CS2 环境" Style="{StaticResource GroupTitle}"/>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,4"/>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="安装路径"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Cs2Path}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="进程状态"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Cs2RunningText}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="Patch / Client"/><TextBlock Style="{StaticResource FieldValue}"><Run Text="{Binding PatchVersion, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ClientVersion, Mode=OneWay}"/></TextBlock></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="Build ID"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding BuildId}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="与测试基线"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding TestedBuildMatch}"/></Grid>

                    <TextBlock Text="运行组件" Style="{StaticResource GroupTitle}" Margin="0,26,0,6"/>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,4"/>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="gameinfo MetaMod 启动项"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding GameinfoHasMetamod, Converter={StaticResource TrueFalseText}}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="MetaMod 原生组件"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding MetaModStatus}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="CounterStrikeSharp"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding CssStatus}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="InventorySimulator 插件"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding InventorySimulatorStatusText}"/></Grid>
                    <Grid Margin="0,7,0,2"><TextBlock Style="{StaticResource FieldLabel}" Text="Patched DLL 校验"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding PatchedDllMatch}"/></Grid>
                    <Grid Margin="0,0,0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="插件哈希"/><TextBlock Style="{StaticResource FieldHash}" Text="{Binding PatchedDllHash}"/></Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="饰品数据" Style="{StaticResource GroupTitle}"/>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,4"/>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="运行文件已安装"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding FixtureStatusText}"/></Grid>
                    <Grid Margin="0,0,0,2"><TextBlock Style="{StaticResource FieldLabel}" Text="当前文件哈希"/><TextBlock Style="{StaticResource FieldHash}" Text="{Binding FixtureHash}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="游戏内当前预设"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding ActivePreset}"/></Grid>

                    <TextBlock Text="最近应用与恢复" Style="{StaticResource GroupTitle}" Margin="0,26,0,6"/>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,4"/>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="预设"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding LatestApplyPreset}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="时间"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding LatestApplyTime}"/></Grid>
                    <Grid Margin="0,0,0,2"><TextBlock Style="{StaticResource FieldLabel}" Text="投影哈希"/><TextBlock Style="{StaticResource FieldHash}" Text="{Binding LatestApplyHash}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="备份"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding BackupStatusText}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="与当前文件一致"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding LatestHashStatusText}"/></Grid>
                    <Grid Margin="0,7,0,2"><TextBlock Style="{StaticResource FieldLabel}" Text="可恢复"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding RollbackCanExecute, Converter={StaticResource TrueFalseText}}"/></Grid>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding RollbackReason}"/>

                    <TextBlock Text="本地物品清单" Style="{StaticResource GroupTitle}" Margin="0,26,0,6"/>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,4"/>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="固定版本"/><TextBlock Style="{StaticResource FieldHash}" Text="{Binding CatalogCommit}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="已载入语言"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding CatalogLocales}"/></Grid>
                    <Grid Margin="0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="中文覆盖"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding ChineseCoverage}"/></Grid>
                    <Grid Margin="0,7,0,2"><TextBlock Style="{StaticResource FieldLabel}" Text="内容"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding CatalogCounts}"/></Grid>
                    <Grid Margin="0,0,0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="清单目录"/><TextBlock Style="{StaticResource FieldHash}" Text="{Binding CatalogCacheRoot}"/></Grid>
                    <Grid Margin="0,0,0,2"><TextBlock Style="{StaticResource FieldLabel}" Text="图片缓存"/><TextBlock Style="{StaticResource FieldValue}" Text="{Binding ImageCacheState}"/></Grid>
                    <Grid Margin="0,0,0,7"><TextBlock Style="{StaticResource FieldLabel}" Text="图片目录"/><TextBlock Style="{StaticResource FieldHash}" Text="{Binding ImageCacheRoot}"/></Grid>

                    <Button Content="准备本地清单" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Command="{Binding DataContext.SyncCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="{Binding DataContext.CatalogSyncMessage, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}"
                       Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
