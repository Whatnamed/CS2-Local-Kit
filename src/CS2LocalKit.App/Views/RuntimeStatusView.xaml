<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CS2LocalKit.App.Views.RuntimeStatusView">
    <DockPanel Margin="24,0,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="重新检查" Command="{Binding RefreshCommand}"/>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding HealthTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding HealthNextStep}" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding IsStatusVisible,Converter={StaticResource BoolToVis}}"/>
        <TabControl AutomationProperties.AutomationId="HealthWorkspaceTabs">
            <TabItem Header="健康概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="检查结果与阻断原因" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Status.BlockedReasons}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource BrushDanger}" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Status.AttentionReasons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource BrushWarning}" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="文件身份匹配只证明安装事实，不能代替模型、动画、Bot 行为或性能的实机验收。" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="运行组件" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MetaMod" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MetaModStatus}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CounterStrikeSharp" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CssStatus}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Human runtime" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InventorySimulatorStatusText}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DLL 身份" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PatchedDllMatch}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="游戏文件" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FixtureStatusText}" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CS2 与本地数据" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CS2 进程" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Cs2RunningText}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Patch / build" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PatchVersion}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Build ID" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildId}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="与验证基线" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TestedBuildMatch}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="已写入的饰品" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledConfigText}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="144"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="激活指针" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActivePreset}" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="Bot 安装与当前事务" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding DataContext.Bot.CurrentMode,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding DataContext.Bot.HumanStatusText,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        <Button Content="打开 Bot 安装与恢复" Command="{Binding DataContext.Navigation.NavigateBotCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Margin="0,12,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="文件与清单证据">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="安装与文件证据" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CS2 目录" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Cs2Path}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="插件 SHA256" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PatchedDllHash}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="游戏配置 SHA256" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding FixtureHash}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最近应用的预设" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LatestApplyPreset}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最近应用时间" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LatestApplyTime}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="投影 SHA256" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LatestApplyHash}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="备份" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding BackupStatusText}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前文件与记录" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LatestHashStatusText}" TextWrapping="Wrap"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="固定版本物品清单" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Source commit" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CatalogCommit}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="载入语言" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CatalogLocales}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="中文覆盖" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ChineseCoverage}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内容" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CatalogCounts}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="清单目录" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CatalogCacheRoot}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="预览图片" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ImageCacheState}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图片目录" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ImageCacheRoot}" TextWrapping="Wrap"/>
                        </Grid>
                        <Button Content="{Binding DataContext.CatalogSyncButtonText,RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.SyncCatalogCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding DataContext.CatalogSyncMessage,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource HintText}"/>
                        <TextBlock Text="仅准备固定版本清单到应用数据目录，独立于游戏文件和个人预设。" Style="{StaticResource HintText}" Margin="0,8,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="恢复与修复">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="恢复上一次 Human 应用" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="只恢复应用记录拥有的饰品文件。执行前再次验证当前文件与备份；不会覆盖未知漂移。" Style="{StaticResource HintText}" Margin="0,10,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{Binding RollbackReason}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LatestApplyTime,StringFormat='最近应用：{0}'}" Style="{StaticResource HintText}" Margin="0,8,0,12"/>
                                <Button Content="恢复上一次应用…" Command="{Binding RestoreLatestCommand}" Style="{StaticResource DangerButton}" ToolTip="{Binding RollbackReason}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RestoreHumanApplication"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="修复 MetaMod 启动项" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="仅在 CS2 关闭、framework 身份完全匹配时可修复 gameinfo 的 SearchPaths 启动入口。写入前创建备份。" Style="{StaticResource HintText}" Margin="0,10,0,14"/>
                        <TextBlock Text="{Binding RepairMetaModStartupToolTip}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Button Content="修复启动项…" Command="{Binding RepairMetaModStartupCommand}" ToolTip="{Binding RepairMetaModStartupToolTip}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RepairMetaModStartup"/>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="增强 Bot 事务必须在「Bot 安装」中按原 install ID 精确恢复；Human 恢复不会代替 Bot 恢复。" Style="{StaticResource HintText}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
