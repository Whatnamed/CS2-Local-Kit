<UserControl x:Class="CS2LocalKit.App.Views.RuntimeStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Margin" Value="0,0,14,9"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="状态" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HealthSummary}" Foreground="{StaticResource BrushTextSecondary}"
                           TextWrapping="Wrap" Margin="0,5,18,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshCommand}"
                    VerticalAlignment="Top"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Background="{StaticResource BrushBgWindow}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Width="860" HorizontalAlignment="Center" Margin="0,0,18,0">
                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,17" Margin="0,0,0,19">
                    <StackPanel>
                        <TextBlock Text="游戏" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="安装路径" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Cs2Path}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="1" Text="运行状态" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cs2RunningText}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="2" Text="版本 / Build" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding PatchVersion}"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding BuildId}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="测试基准" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TestedBuildMatch}" Style="{StaticResource FieldValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,17" Margin="0,0,0,19">
                    <StackPanel>
                        <TextBlock Text="Runtime" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="MetaMod" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding MetaModStatus}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="1" Text="CounterStrikeSharp" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CssStatus}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="2" Text="InventorySimulator" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InventorySimulatorStatusText}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="3" Text="Patched DLL" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PatchedDllMatch}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="4" Text="Fixture" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FixtureStatusText}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="5" Text="Fixture SHA256" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FixtureHash}" Style="{StaticResource FieldValue}"
                                       FontFamily="Consolas" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,17" Margin="0,0,0,19">
                    <StackPanel>
                        <TextBlock Text="当前配置" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="已激活预设" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActivePreset}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="1" Text="最近应用" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestApplyTime}" Style="{StaticResource FieldValue}"/>
                            <TextBlock Grid.Row="2" Text="应用的预设" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatestApplyPreset}" Style="{StaticResource FieldValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="恢复" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="备份" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BackupStatusText}" Style="{StaticResource FieldValue}"/>
                        <TextBlock Grid.Row="1" Text="当前文件匹配" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestHashStatusText}" Style="{StaticResource FieldValue}"/>
                        <TextBlock Grid.Row="2" Text="恢复条件" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RollbackReason}" Style="{StaticResource FieldValue}"/>
                    </Grid>
                    <Button Content="恢复上一次应用" Command="{Binding RestoreLatestCommand}"
                            Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left"
                            Margin="0,9,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,0"
                   Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
