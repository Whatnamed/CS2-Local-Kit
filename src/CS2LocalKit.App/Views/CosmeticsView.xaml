<UserControl x:Class="CS2LocalKit.App.Views.CosmeticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="24,14,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4"
                    Visibility="{Binding IsMusicKitTab, Converter={StaticResource InvBoolToVis}}">
            <RadioButton Content="CT" IsChecked="{Binding IsCt}" GroupName="Team"
                         Style="{StaticResource SegmentButtonStyle}" Margin="0,0,8,0"/>
            <RadioButton Content="T" IsChecked="{Binding IsT}" GroupName="Team"
                         Style="{StaticResource SegmentButtonStyle}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Content="枪械" IsChecked="{Binding IsWeaponsTab, Mode=OneWay}"
                         GroupName="Category" Click="OnWeaponsTabClick"
                         Style="{StaticResource SegmentButtonStyle}" Margin="0,0,8,0"/>
            <RadioButton Content="刀具" IsChecked="{Binding IsKnifeTab, Mode=OneWay}"
                         GroupName="Category" Click="OnKnifeTabClick"
                         Style="{StaticResource SegmentButtonStyle}" Margin="0,0,8,0"/>
            <RadioButton Content="手套" IsChecked="{Binding IsGlovesTab, Mode=OneWay}"
                         GroupName="Category" Click="OnGlovesTabClick"
                         Style="{StaticResource SegmentButtonStyle}" Margin="0,0,8,0"/>
            <RadioButton Content="音乐盒" IsChecked="{Binding IsMusicKitTab, Mode=OneWay}"
                         GroupName="Category" Click="OnMusicKitTabClick"
                         Style="{StaticResource SegmentButtonStyle}"/>
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding IsWeaponsTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="枪械" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="搜索枪械" Foreground="{StaticResource BrushTextMuted}"
                               FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="2" AutomationProperties.Name="搜索枪械"
                             Text="{Binding WeaponSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10"/>
                    <ListBox Grid.Row="3" AutomationProperties.Name="枪械列表"
                             ItemsSource="{Binding FilteredWeapons}" SelectedItem="{Binding SelectedWeapon}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <Ellipse Grid.Column="1" Width="5" Height="5" Margin="8,0,2,0"
                                             Fill="{StaticResource BrushAccent}" VerticalAlignment="Center"
                                             Visibility="{Binding HasCosmetic, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding CurrentWeaponDraft, Converter={StaticResource NullToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedWeapon.Name}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrentWeaponDraft.DefIndex, StringFormat='DefIndex {0}'}"
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="移除配置"
                                        Command="{Binding RemoveWeaponCosmeticCommand}"
                                        Style="{StaticResource DangerButtonStyle}"/>
                            </Grid>
                            <TextBlock Text="皮肤" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox AutomationProperties.Name="搜索皮肤"
                                     Text="{Binding PaintSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,7"/>
                            <ComboBox AutomationProperties.Name="选择皮肤"
                                      ItemsSource="{Binding FilteredPaints}" SelectedItem="{Binding SelectedPaint}"
                                      DisplayMemberPath="Name" MaxDropDownHeight="260" Margin="0,0,0,16"/>
                            <TextBlock Text="磨损度" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="84"/>
                                </Grid.ColumnDefinitions>
                                <Slider AutomationProperties.Name="枪械磨损度" Minimum="0" Maximum="1"
                                        Value="{Binding CurrentWeaponDraft.Wear, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <TextBox Grid.Column="1" AutomationProperties.Name="枪械磨损度数值"
                                         Text="{Binding CurrentWeaponDraft.Wear, Converter={StaticResource DoubleFormat}, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="图案模板 Seed" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                    <TextBox AutomationProperties.Name="枪械 Seed"
                                             Text="{Binding CurrentWeaponDraft.Seed, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="名称标签" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                    <TextBox AutomationProperties.Name="枪械名称标签"
                                             Text="{Binding CurrentWeaponDraft.NameTag, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="启用 StatTrak" IsChecked="{Binding CurrentWeaponDraft.StatTrakEnabled}"
                                      Margin="0,0,0,8"/>
                            <TextBox AutomationProperties.Name="枪械 StatTrak 数值"
                                     Text="{Binding CurrentWeaponDraft.StatTrakCount, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding CurrentWeaponDraft.StatTrakEnabled, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6,0,0"
                                Visibility="{Binding CurrentWeaponDraft, Converter={StaticResource NotNullToVis}}">
                        <TextBlock Text="{Binding SelectedWeapon.Name}" FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <TextBlock Text="此武器尚未配置饰品" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,17"/>
                        <Button Content="配置此武器" Command="{Binding AddOrConfigureWeaponCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding IsKnifeTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="已配置的刀具" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" AutomationProperties.Name="刀具列表"
                             ItemsSource="{Binding ConfiguredKnives}" SelectedItem="{Binding SelectedKnifePreset}"
                             SelectionChanged="OnKnifeSelectionChanged"
                             IsVisibleChanged="OnKnifeListVisibleChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding KnifeName}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding KnifeName}"/>
                                    <TextBlock Text="{Binding PaintName}" Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="添加刀具" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox AutomationProperties.Name="添加刀具型号"
                                  ItemsSource="{Binding AvailableCatalogKnives}" SelectedItem="{Binding KnifeToAdd}"
                                  DisplayMemberPath="Name" Margin="0,0,0,8"/>
                        <Button Content="添加" Command="{Binding AddKnifePresetCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardPanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedKnifePreset, Converter={StaticResource NullToVis}}">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedKnifePreset.KnifeName}" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="当前刀具" Foreground="{StaticResource BrushGreen}" FontSize="12"
                                   Visibility="{Binding IsSelectedKnifeCurrent, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button Content="设为当前" Command="{Binding SetCurrentKnifeCommand}" Margin="0,0,9,0"/>
                            <Button Content="删除预设" Command="{Binding DeleteKnifePresetCommand}"
                                    Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                        <TextBlock Text="皮肤" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox AutomationProperties.Name="搜索刀具皮肤"
                                 Text="{Binding KnifePaintSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,7"/>
                        <ComboBox AutomationProperties.Name="选择刀具皮肤"
                                  ItemsSource="{Binding FilteredKnifePaints}" SelectedItem="{Binding SelectedKnifePaint}"
                                  DisplayMemberPath="Name" MaxDropDownHeight="260" Margin="0,0,0,16"/>
                        <TextBlock Text="磨损度" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <Slider AutomationProperties.Name="刀具磨损度" Minimum="0" Maximum="1"
                                    Value="{Binding SelectedKnifePreset.Wear, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBox Grid.Column="1" AutomationProperties.Name="刀具磨损度数值"
                                     Text="{Binding SelectedKnifePreset.Wear, Converter={StaticResource DoubleFormat}, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="图案模板 Seed" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                <TextBox AutomationProperties.Name="刀具 Seed"
                                         Text="{Binding SelectedKnifePreset.Seed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="名称标签" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                <TextBox AutomationProperties.Name="刀具名称标签"
                                         Text="{Binding SelectedKnifePreset.NameTag, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="启用 StatTrak" IsChecked="{Binding SelectedKnifePreset.StatTrakEnabled}"
                                  Margin="0,0,0,8"/>
                        <TextBox AutomationProperties.Name="刀具 StatTrak 数值"
                                 Text="{Binding SelectedKnifePreset.StatTrakCount, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding SelectedKnifePreset.StatTrakEnabled, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}"
                MaxWidth="800" HorizontalAlignment="Center"
                Visibility="{Binding IsGlovesTab, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="560" HorizontalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="手套" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <CheckBox Content="为当前阵营启用手套" IsChecked="{Binding CurrentGloves.Enabled}"
                              Margin="0,0,0,22"/>
                    <TextBlock Text="手套型号" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox AutomationProperties.Name="选择手套型号"
                              ItemsSource="{Binding AvailableGloves}" SelectedItem="{Binding SelectedGloveDef}"
                              DisplayMemberPath="Name" Margin="0,0,0,18"/>
                    <TextBlock Text="皮肤" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox AutomationProperties.Name="选择手套皮肤"
                              ItemsSource="{Binding AvailableGlovePaints}" SelectedItem="{Binding SelectedGlovePaint}"
                              DisplayMemberPath="Name" Margin="0,0,0,18"/>
                    <TextBlock Text="磨损度" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Slider AutomationProperties.Name="手套磨损度" Minimum="0" Maximum="1"
                                Value="{Binding CurrentGloves.Wear, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBox Grid.Column="1" AutomationProperties.Name="手套磨损度数值"
                                 Text="{Binding CurrentGloves.Wear, Converter={StaticResource DoubleFormat}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <TextBlock Text="图案模板 Seed" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox AutomationProperties.Name="手套 Seed" Width="170" HorizontalAlignment="Left"
                             Text="{Binding CurrentGloves.Seed, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}"
                MaxWidth="800" HorizontalAlignment="Center"
                Visibility="{Binding IsMusicKitTab, Converter={StaticResource BoolToVis}}">
            <Grid Width="680" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="音乐盒" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="1" Text="全局设置，不区分 CT / T"
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,18"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="当前选择  " Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding SelectedMusicKit.Name, TargetNullValue=未选择音乐盒}"/>
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox AutomationProperties.Name="搜索音乐盒"
                             Text="{Binding MusicKitSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="清除选择" Command="{Binding ClearMusicKitCommand}"/>
                </Grid>
                <ListBox Grid.Row="4" AutomationProperties.Name="音乐盒列表"
                         ItemsSource="{Binding FilteredMusicKits}" SelectedItem="{Binding SelectedMusicKit}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
