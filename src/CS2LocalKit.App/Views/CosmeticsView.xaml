<UserControl x:Class="CS2LocalKit.App.Views.CosmeticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:CS2LocalKit.App.Common"
             xmlns:vm="clr-namespace:CS2LocalKit.App.ViewModels"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <UserControl.Resources>
        <!-- The three scrolling surfaces on this page (model list, card grid, detail rail) are driven
             by wheel, trackpad and keyboard, so the vertical bar was chrome competing with the art it
             belonged to. Collapsing rather than hiding it also gives the reserved gutter back. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- one finish/music card; selection and art are both driven from the view model -->
        <DataTemplate x:Key="CardTemplate">
            <ToggleButton Style="{StaticResource CardToggle}"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.SelectSkinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                <Grid Height="120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushPlaceholder}"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Image x:Name="SkinArt" Margin="7" Stretch="Uniform"
                                   common:LazyImage.Url="{Binding ThumbnailUrl}"
                                   common:LazyImage.PixelWidth="232"/>
                            <!-- waiting for art and having no art are different facts -->
                            <TextBlock Text="加载中" FontSize="10.5"
                                       Foreground="{StaticResource BrushTextDisabled}" Opacity="0.7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=SkinArt, Converter={StaticResource EqToVis}, ConverterParameter=Loading}"/>
                            <TextBlock Text="无预览" FontSize="10.5"
                                       Foreground="{StaticResource BrushTextDisabled}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=SkinArt, Converter={StaticResource EqToVis}, ConverterParameter=Unavailable}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="9,6,9,2">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SecondaryName}" FontSize="10.5"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SecondaryName, Converter={StaticResource NonEmptyToVis}}"/>
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="3" Margin="10,0"
                            Background="{Binding RarityColor, Converter={StaticResource HexToBrush}}"/>
                </Grid>
            </ToggleButton>
        </DataTemplate>

        <DataTemplate x:Key="MusicCardTemplate">
            <ToggleButton Style="{StaticResource CardToggle}"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.SelectMusicKitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                <Grid Height="120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BrushPlaceholder}" CornerRadius="8,8,0,0">
                        <Grid>
                            <Image x:Name="MusicArt" Margin="7" Stretch="Uniform"
                                   common:LazyImage.Url="{Binding ThumbnailUrl}"
                                   common:LazyImage.PixelWidth="232"/>
                            <TextBlock Text="加载中" FontSize="10.5"
                                       Foreground="{StaticResource BrushTextDisabled}" Opacity="0.7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=MusicArt, Converter={StaticResource EqToVis}, ConverterParameter=Loading}"/>
                            <TextBlock Text="无预览" FontSize="10.5"
                                       Foreground="{StaticResource BrushTextDisabled}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=MusicArt, Converter={StaticResource EqToVis}, ConverterParameter=Unavailable}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="9,6,9,2">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SecondaryName}" FontSize="10.5"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SecondaryName, Converter={StaticResource NonEmptyToVis}}"/>
                    </StackPanel>
                    <Border Grid.Row="2" CornerRadius="3" Margin="10,0"
                            Background="{Binding RarityColor, Converter={StaticResource HexToBrush}}"/>
                </Grid>
            </ToggleButton>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,4,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- section and team -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource BrushBgSurface}" CornerRadius="9" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="武器" GroupName="section"
                                 IsChecked="{Binding IsWeaponsSection, Mode=OneWay}"
                                 Command="{Binding SelectSectionCommand}"
                                 CommandParameter="{x:Static vm:CosmeticsSection.Weapons}"/>
                    <RadioButton Style="{StaticResource Segment}" Content="刀具" GroupName="section"
                                 IsChecked="{Binding IsKnivesSection, Mode=OneWay}"
                                 Command="{Binding SelectSectionCommand}"
                                 CommandParameter="{x:Static vm:CosmeticsSection.Knives}"/>
                    <RadioButton Style="{StaticResource Segment}" Content="手套" GroupName="section"
                                 IsChecked="{Binding IsGlovesSection, Mode=OneWay}"
                                 Command="{Binding SelectSectionCommand}"
                                 CommandParameter="{x:Static vm:CosmeticsSection.Gloves}"/>
                    <RadioButton Style="{StaticResource Segment}" Content="音乐盒" GroupName="section"
                                 IsChecked="{Binding IsMusicKitSection, Mode=OneWay}"
                                 Command="{Binding SelectSectionCommand}"
                                 CommandParameter="{x:Static vm:CosmeticsSection.MusicKit}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding TeamSummaryText}" Style="{StaticResource HintText}"
                       VerticalAlignment="Center" Margin="18,0,18,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ShowsTeamContext, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource BrushBgSurface}" CornerRadius="9" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="反恐精英" GroupName="team"
                                         IsChecked="{Binding IsCt, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="恐怖分子" GroupName="team"
                                         IsChecked="{Binding IsT, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="14,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowsGlovesSwitch, Converter={StaticResource BoolToVis}}">
                        <CheckBox Style="{StaticResource Switch}" Content="启用手套"
                                  IsChecked="{Binding GlovesEnabled}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="全局 · 双方共用" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Visibility="{Binding ShowsTeamContext, Converter={StaticResource InvBoolToVis}}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BrushAccentSoft}" CornerRadius="9" Padding="14,10"
                Margin="0,0,0,12"
                Visibility="{Binding DataContext.CatalogUnavailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="本地物品清单尚未准备" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"
                               Text="没有清单时无法浏览或校验皮肤，保存与应用会被阻断。点击下方按钮下载当前固定版本的英文与简体中文数据（仅写入本地应用数据目录）。"/>
                </StackPanel>
                <Button Content="{Binding DataContext.CatalogSyncButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding DataContext.SyncCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Border>

        <!-- browser: model list -> finish grid -> editing detail -->
        <Grid Grid.Row="2" Visibility="{Binding IsMusicKitSection, Converter={StaticResource InvBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- model list -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,10,8">
                        <TextBox Style="{StaticResource CompactInput}" MinHeight="34" Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="搜索武器（中文 / English / #ID）" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushTextDisabled}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ItemSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <CheckBox Content="只看已配置" IsChecked="{Binding OnlyConfigured}" Margin="0,0,14,10"/>
                </StackPanel>

                <Border Background="{StaticResource BrushBgSurface}" CornerRadius="11" Padding="4,4,4,4">
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ListRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="28" CornerRadius="5"
                                            Background="{StaticResource BrushPlaceholder}" Margin="0,0,10,0"
                                            Visibility="{Binding ImageUrl, Converter={StaticResource NotNullToVis}}">
                                        <Grid>
                                            <Image Stretch="Uniform" Margin="3"
                                                   common:LazyImage.Url="{Binding ImageUrl}"
                                                   common:LazyImage.PixelWidth="116"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Summary, Converter={StaticResource NonEmptyToVis}}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                            CornerRadius="4" Padding="6,2" Background="{StaticResource BrushAccentSoft}"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="当前" FontSize="10.5" Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                    <Ellipse Grid.Column="2" Width="6" Height="6" Margin="8,0,0,0"
                                             VerticalAlignment="Center" Fill="{StaticResource BrushSuccess}"
                                             Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- finish grid -->
            <DockPanel Grid.Column="1" LastChildFill="True" x:Name="SkinHost">
                <StackPanel DockPanel.Dock="Top" Margin="16,0,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DetailWeaponName}" Style="{StaticResource SectionTitle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DetailWeaponSecondaryName}" Style="{StaticResource HintText}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding DetailWeaponSecondaryName, Converter={StaticResource NonEmptyToVis}}"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <TextBox Style="{StaticResource CompactInput}" MinHeight="34"
                                     Text="{Binding SkinSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="搜索皮肤" FontSize="12" Margin="10,0,0,0"
                                       Foreground="{StaticResource BrushTextDisabled}"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SkinSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SkinsHintText}" Style="{StaticResource HintText}"
                           Margin="16,10,14,0"/>

                <Grid Margin="16,0,4,0">
                    <Border x:Name="SkinGridBorder" Background="{StaticResource BrushBgSurface}" CornerRadius="11" Padding="4">
                        <ListBox x:Name="SkinRowList" ItemsSource="{Binding SkinRows}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionMode="Extended">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Cards}"
                                                  ItemTemplate="{StaticResource CardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock Text="{Binding GridPlaceholderText}" Style="{StaticResource HintText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource VerticalDivider}" Margin="8,0"/>

            <!-- editing detail -->
            <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,10,0">
                <StackPanel Margin="0,0,4,16">
                    <Border Height="168" CornerRadius="10" Background="{StaticResource BrushPlaceholder}">
                        <Grid>
                            <Image x:Name="DetailArt" Margin="12" Stretch="Uniform"
                                   common:LazyImage.Url="{Binding DetailImageUrl}"
                                   common:LazyImage.PixelWidth="512"/>
                            <TextBlock Text="选择皮肤后显示预览" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextDisabled}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding DetailImageUrl, Converter={StaticResource EmptyToVis}}"/>
                            <TextBlock Text="预览加载中" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextDisabled}" Opacity="0.7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=DetailArt, Converter={StaticResource EqToVis}, ConverterParameter=Loading}"/>
                            <TextBlock Text="暂无预览" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextDisabled}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=DetailArt, Converter={StaticResource EqToVis}, ConverterParameter=Unavailable}"/>
                        </Grid>
                    </Border>

                    <Border Height="4" CornerRadius="2" Margin="0,8,0,0"
                            Background="{Binding DetailRarityBrush, FallbackValue={StaticResource BrushBorderSubtle}}"/>

                    <TextBlock Text="{Binding DetailPaintName}" Style="{StaticResource SectionTitle}"
                               Margin="0,14,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DetailPaintSecondary}" Style="{StaticResource MutedText}"
                               FontSize="12" Margin="0,2,0,0"
                               Visibility="{Binding DetailPaintSecondary, Converter={StaticResource NonEmptyToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding DetailPaintIndex}" Style="{StaticResource MonoText}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding DetailRarityLabel}" Style="{StaticResource HintText}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DetailFloatRange}" Style="{StaticResource HintText}" Margin="0,3,0,0"
                               Visibility="{Binding DetailFloatRange, Converter={StaticResource NonEmptyToVis}}"/>

                    <Border Style="{StaticResource Divider}"/>

                    <StackPanel Visibility="{Binding IsEntryConfigured, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="磨损度" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                            <TextBlock HorizontalAlignment="Right">
                                <Run Text="{Binding WearBucketText, Mode=OneWay}" Foreground="{StaticResource BrushTextPrimary}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding WearValueText, Mode=OneWay}" Foreground="{StaticResource BrushTextSecondary}"
                                     FontFamily="{StaticResource FontMono}"/>
                            </TextBlock>
                        </Grid>
                        <Slider Style="{StaticResource WearSlider}" Margin="0,8,0,2"
                                Value="{Binding DetailEntry.Wear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding WearBucketRange}" Style="{StaticResource HintText}"
                                   HorizontalAlignment="Right"/>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="磨损编号 (Seed)" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource CompactInput}" Width="96" HorizontalAlignment="Right"
                                     Text="{Binding DetailEntry.Seed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <StackPanel Visibility="{Binding EntrySupportsDetails, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="StatTrak™" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding DetailEntry.StatTrakEnabled, Mode=TwoWay}"/>
                            </Grid>
                            <Grid Margin="0,12,0,0"
                                  Visibility="{Binding DetailEntry.StatTrakEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="击杀数" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource CompactInput}" Width="96" HorizontalAlignment="Right"
                                         Text="{Binding DetailEntry.StatTrakCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Text="名称标签" Style="{StaticResource MutedText}" Margin="0,14,0,4"/>
                            <TextBox Style="{StaticResource {x:Type TextBox}}"
                                     Text="{Binding DetailEntry.NameTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="改名标签需要游戏内改名卡支持，此字段仅写入预设。"/>
                        </StackPanel>

                        <Border Background="{StaticResource BrushBgSurface}" CornerRadius="9" Padding="12,10" Margin="0,18,0,0"
                                Visibility="{Binding EntrySupportsDetails, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="磨损、磨损编号与 StatTrak 只影响外观表现，不会改变武器本身。"/>
                        </Border>

                        <Button Content="移除此皮肤" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                Command="{Binding RemoveCosmeticCommand}"/>
                    </StackPanel>

                    <Button Content="设为当前刀" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0"
                            Visibility="{Binding IsKnivesSection, Converter={StaticResource BoolToVis}}"
                            Command="{Binding SetCurrentKnifeCommand}"/>

                    <Border Background="{StaticResource BrushBgSurface}" CornerRadius="9" Padding="13,11" Margin="0,16,0,0"
                            Visibility="{Binding IsGlovesDisabledNotice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="手套当前未启用" Style="{StaticResource MutedText}"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                       Text="启用后可选择型号与外观；停用会保留已保存的型号与皮肤。"/>
                            <Button Content="启用手套" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                    Command="{Binding EnableGlovesCommand}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsEntryConfigured, Converter={StaticResource InvBoolToVis}}">
                        <Border Background="{StaticResource BrushBgSurface}" CornerRadius="9" Padding="13,11" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="该武器尚未配置皮肤。在左侧点选一张卡片即可应用外观并进入编辑。"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- music kits: global, so the browser columns collapse into one grid plus detail -->
        <Grid Grid.Row="2" Visibility="{Binding IsMusicKitSection, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" LastChildFill="True" x:Name="MusicHost">
                <Grid DockPanel.Dock="Top" Margin="0,0,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="点击卡片选择全局音乐盒，双方共用同一首。" Style="{StaticResource HintText}"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <TextBox Style="{StaticResource CompactInput}" MinHeight="34"
                                 Text="{Binding MusicKitSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="搜索音乐盒（中文 / English / #ID）" FontSize="12" Margin="10,0,0,0"
                                   Foreground="{StaticResource BrushTextDisabled}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MusicKitSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,4,0">
                    <Border x:Name="MusicGridBorder" Background="{StaticResource BrushBgSurface}" CornerRadius="11" Padding="4">
                        <ListBox ItemsSource="{Binding MusicKitRows}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Extended">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Cards}"
                                                  ItemTemplate="{StaticResource MusicCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock Text="{Binding GridPlaceholderText}" Style="{StaticResource HintText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource VerticalDivider}" Margin="8,0"/>

            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                <Border Height="168" CornerRadius="10" Background="{StaticResource BrushPlaceholder}">
                    <Grid>
                        <Image x:Name="MusicDetailArt" Margin="12" Stretch="Uniform"
                               common:LazyImage.Url="{Binding MusicKitImageUrl}"
                               common:LazyImage.PixelWidth="512"/>
                        <!-- A missing preview is not the same fact as no music kit selected. -->
                        <TextBlock Text="未选择音乐盒" FontSize="11.5"
                                   Foreground="{StaticResource BrushTextDisabled}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsMusicKitConfigured, Converter={StaticResource InvBoolToVis}}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsMusicKitConfigured, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="预览加载中" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextDisabled}" Opacity="0.7"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=MusicDetailArt, Converter={StaticResource EqToVis}, ConverterParameter=Loading}"/>
                            <TextBlock Text="暂无预览" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextDisabled}"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding Path=(common:LazyImage.ArtState), ElementName=MusicDetailArt, Converter={StaticResource EqToVis}, ConverterParameter=Unavailable}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding MusicKitName}" Style="{StaticResource SectionTitle}"
                           Margin="0,14,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MusicKitSecondaryName}" Style="{StaticResource MutedText}"
                           FontSize="12" Margin="0,2,0,0"
                           Visibility="{Binding MusicKitSecondaryName, Converter={StaticResource NonEmptyToVis}}"/>
                <TextBlock Text="{Binding MusicKitIdText}" Style="{StaticResource MonoText}" Margin="0,8,0,0"
                           Visibility="{Binding MusicKitIdText, Converter={StaticResource NonEmptyToVis}}"/>

                <Border Background="{StaticResource BrushBgSurface}" CornerRadius="9" Padding="13,11" Margin="0,16,0,0"
                        Visibility="{Binding IsMusicKitConfigured, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="音乐盒是全局设置，不属于 CT 或 T；未选择时游戏使用默认音乐。"/>
                </Border>

                <Button Content="清除音乐盒" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch"
                        Margin="0,14,0,0" Command="{Binding ClearMusicKitCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
