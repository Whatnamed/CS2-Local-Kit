<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ImplicitlyExpandNETStandardFacades>true</ImplicitlyExpandNETStandardFacades>
    <Description>CS2 Local Kit product layer: HumanPreset domain, pinned catalog, InventorySimulator projection, apply/rollback, runtime status. Windows-only by product boundary.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CS2LocalKit.Core.Tests" />
    <EmbeddedResource Include="..\..\data\match-setup\*.json" LogicalName="CS2LocalKit.MatchSetup.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\scripts\compatibility\review-14193.json" LogicalName="CS2LocalKit.Review14193.json" />
    <EmbeddedResource Include="..\..\scripts\compatibility\review-14194.json" LogicalName="CS2LocalKit.Review14194.json" />
    <EmbeddedResource Include="..\..\scripts\compatibility\review-14195.json" LogicalName="CS2LocalKit.Review14195.json" />
  </ItemGroup>

</Project>
